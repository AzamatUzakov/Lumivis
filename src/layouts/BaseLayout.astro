---
import "../styles/global.css";
import "lenis/dist/lenis.css";
// Onest & Inter — self-hosted via Fontsource (кириллица + латиница гарантированы, 0 CDN-запросов)
import "@fontsource-variable/onest";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import type { Lang } from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = "Lumivis — Офтальмологическая клиника в Самарканде | РН-скрининг и лечение глаз",
  description = "Клиника Lumivis в Самарканде: единственная частная клиника РН-скрининга недоношенных. Полный цикл диагностики, лечения косоглазия, амблиопии у детей и взрослых.",
  lang = "ru",
} = Astro.props;

// Strip language prefix from pathname to get relative page path (e.g. "" or "privacy")
const rawPath = Astro.url.pathname.replace(/^\/(ru|uz|en)\/?/, "");
const currentPath = rawPath ? `${rawPath}` : "";

const canonicalUrl = `https://lumivis.uz/${lang}/${currentPath}`;
const ogLocale = lang === "uz" ? "uz_UZ" : lang === "en" ? "en_US" : "ru_UZ";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png?v=3" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical and Hreflang Tags -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ru-UZ" href={`https://lumivis.uz/ru/${currentPath}`} />
    <link rel="alternate" hreflang="uz-UZ" href={`https://lumivis.uz/uz/${currentPath}`} />
    <link rel="alternate" hreflang="en-UZ" href={`https://lumivis.uz/en/${currentPath}`} />
    <link rel="alternate" hreflang="x-default" href={`https://lumivis.uz/ru/${currentPath}`} />

    <!-- Open Graph & Social Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Lumivis Ophthalmology Clinic" />
    <meta property="og:image" content="https://lumivis.uz/logo.png" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Schema.org JSON-LD Microdata -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalClinic",
      "name": "Lumivis Ophthalmology Clinic",
      "alternateName": lang === "uz" ? "Lumivis — Samarqandda ko'z klinikasi" : lang === "en" ? "Lumivis Eye Clinic in Samarkand" : "Lumivis — Офтальмологическая клиника в Самарканде",
      "image": "https://lumivis.uz/logo.png",
      "@id": "https://lumivis.uz/#clinic",
      "url": canonicalUrl,
      "telephone": "+998 99 598 10 10",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": lang === "uz" ? "Rudakiy ko'chasi 217" : lang === "en" ? "217 Rudaki Street" : "улица Рудаки, 217",
        "addressLocality": lang === "uz" ? "Samarqand" : lang === "en" ? "Samarkand" : "Самарканд",
        "addressRegion": lang === "uz" ? "Samarqand viloyati" : lang === "en" ? "Samarkand Region" : "Самаркандская область",
        "addressCountry": "UZ"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 39.666194,
        "longitude": 66.976016
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "medicalSpecialty": [
        "Ophthalmology",
        "PediatricOphthalmology"
      ],
      "availableService": [
        {
          "@type": "MedicalProcedure",
          "name": lang === "uz" ? "Chala tug'ilgan chaqaloqlar retinopatiyasi (ChTChR) skriningi" : lang === "en" ? "ROP screening for retinopathy of prematurity" : "РН-скрининг ретинопатии недоношенных",
          "description": lang === "uz" ? "Chala tug'ilgan chaqaloqlarda retinopatiyani aniqlash va kuzatish" : lang === "en" ? "Screening, tracking and management of ROP in infants" : "Скрининг, наблюдение и ведение ретинопатии у недоношенных детей"
        },
        {
          "@type": "MedicalProcedure",
          "name": lang === "uz" ? "Ko'rish diagnostikasi" : lang === "en" ? "Vision Diagnostics" : "Диагностика зрения",
          "description": lang === "uz" ? "Avtorefrakto-keratometriya, biomikroskopiya, tonometriya, perimetriya" : lang === "en" ? "Autorefractometry, biomicroscopy, tonometry, perimetry" : "Авторефрактометрия, биомикроскопия, тонометрия, периметрия"
        },
        {
          "@type": "MedicalProcedure",
          "name": lang === "uz" ? "G'ilaylik va ambliopiyani davolash" : lang === "en" ? "Strabismus & Amblyopia Treatment" : "Лечение косоглазия и амблиопии",
          "description": lang === "uz" ? "Bolalar va kattalarda apparatli va jarrohlik davolash" : lang === "en" ? "Hardware and surgical treatment for pediatric & adult patients" : "Аппаратное и хирургическое лечение у детей и взрослых"
        }
      ]
    })} />
  </head>
  <body>
    <slot />

    <!-- Core Interactive Client Script -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Dynamic language link switcher with anchor & scroll position preservation
        document.querySelectorAll<HTMLAnchorElement>("a[data-lang-btn]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const targetLang = btn.dataset.langBtn;
            if (!targetLang) return;
            localStorage.setItem("lumivis_lang", targetLang);

            let hash = window.location.hash;

            // If hash is explicitly present (and not #hero), retain it regardless of scroll position
            if (hash && hash !== "#hero") {
              // keep existing hash
            } else if (window.scrollY < 150) {
              // At top of page without explicit section hash: keep clean URL
              hash = "";
            } else {
              // Scrolled down without explicit hash: detect active section
              hash = "";
              const sections = document.querySelectorAll<HTMLElement>("section[id]");
              const scrollPos = window.scrollY + 200;
              for (const sec of sections) {
                if (sec.id !== "hero" && sec.offsetTop <= scrollPos && sec.offsetTop + sec.offsetHeight > scrollPos) {
                  hash = "#" + sec.id;
                  break;
                }
              }
            }

            const rawPath = window.location.pathname.replace(/^\/(ru|uz|en)\/?/, "");
            const newHref = `/${targetLang}/${rawPath}${hash}`;
            btn.setAttribute("href", newHref);
          });
        });

        // Sticky header shadow
        const header = document.getElementById("site-header");
        if (header) {
          const onScroll = () => {
            header.classList.toggle("header--scrolled", window.scrollY > 20);
          };
          window.addEventListener("scroll", onScroll, { passive: true });
        }

        // Burger menu toggle
        const burger = document.getElementById("burger-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        if (burger && mobileMenu) {
          burger.addEventListener("click", () => {
            const open = mobileMenu.classList.toggle("mobile-menu--open");
            burger.setAttribute("aria-expanded", String(open));
            document.body.style.overflow = open ? "hidden" : "";
          });

          // Close on nav link click
          mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
              mobileMenu.classList.remove("mobile-menu--open");
              burger.setAttribute("aria-expanded", "false");
              document.body.style.overflow = "";
            });
          });
        }

        // Init Smooth Scroll with Lenis
        initSmoothScroll();

        // Entrance Animations System
        initAnimations();
      });

      function initSmoothScroll() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        import("lenis").then(({ default: Lenis }) => {
          const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            touchMultiplier: 1.5,
            infinite: false,
          });

          (window as any).lenis = lenis;

          function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);

          // Smooth scroll event delegation for all anchor links
          document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement | null;
            const anchor = target?.closest<HTMLAnchorElement>('a[href^="#"]');
            if (!anchor) return;

            const href = anchor.getAttribute("href");
            if (!href || href === "#") return;

            const targetEl = document.querySelector<HTMLElement>(href);
            if (targetEl) {
              e.preventDefault();

              const mobileMenu = document.getElementById("mobile-menu");
              const burger = document.getElementById("burger-btn");
              if (mobileMenu && mobileMenu.classList.contains("mobile-menu--open")) {
                mobileMenu.classList.remove("mobile-menu--open");
                burger?.setAttribute("aria-expanded", "false");
                document.body.style.overflow = "";
              }

              lenis.scrollTo(targetEl, {
                duration: 1.2,
              });
            }
          });
        }).catch((err) => {
          console.error("Lenis smooth scroll failed to load:", err);
        });
      }

      function initAnimations() {
        const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function handleTransitionEnd(e: Event) {
          const target = e.target as HTMLElement;
          target.classList.remove("will-animate");
          target.removeEventListener("transitionend", handleTransitionEnd);
        }

        function triggerElement(el: HTMLElement, delay: number = 0) {
          if (isReduced) {
            el.classList.add("is-visible");
            return;
          }
          el.classList.add("will-animate");
          if (delay > 0) {
            el.style.transitionDelay = `${delay}ms`;
          }
          el.addEventListener("transitionend", handleTransitionEnd);
          requestAnimationFrame(() => {
            el.classList.add("is-visible");
          });
        }

        // 1. Hero Animation (Initial page load)
        const heroElements = document.querySelectorAll<HTMLElement>(".reveal-hero");
        heroElements.forEach((el, idx) => {
          triggerElement(el, idx * 100);
        });

        // 2. Scroll Reveal Observer
        if (isReduced) {
          document.querySelectorAll<HTMLElement>(".reveal, .reveal-up, .reveal-left, .reveal-right, .reveal-fade").forEach((el) => {
            el.classList.add("is-visible");
          });
          return;
        }

        const observerOptions: IntersectionObserverInit = {
          threshold: 0.15,
          rootMargin: "0px 0px -40px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              observer.unobserve(el);

              let delay = 0;
              const parent = el.parentElement;
              if (parent) {
                const siblings = Array.from(parent.children).filter((child) =>
                  child.matches(".reveal, .reveal-up, .reveal-left, .reveal-right, .reveal-fade")
                );
                if (siblings.length > 1) {
                  const idx = siblings.indexOf(el);
                  if (idx >= 0) {
                    delay = Math.min(idx, 4) * 80;
                  }
                }
              }

              triggerElement(el, delay);
            }
          });
        }, observerOptions);

        const targetElements = document.querySelectorAll<HTMLElement>(
          ".reveal, .reveal-up, .reveal-left, .reveal-right, .reveal-fade"
        );
        targetElements.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
