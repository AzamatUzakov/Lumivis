---
// src/pages/[lang]/privacy.astro — SSG Privacy Policy page for RU, UZ, EN
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import type { SupportedLang } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: "ru" } },
    { params: { lang: "uz" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLang };

const content = {
  ru: {
    title: "Политика конфиденциальности — Офтальмологическая клиника Lumivis, Самарканд",
    description: "Политика конфиденциальности клиники Lumivis. Узнайте, как мы собираем, используем и защищаем ваши персональные данные.",
    h1: "Политика конфиденциальности",
    meta: "Последнее обновление: сентябрь 2026 года",
    sec1Title: "1. Оператор персональных данных",
    sec1Body: `Оператором персональных данных является:<br />
      <strong>Офтальмологическая клиника "Lumivis"</strong><br />
      Адрес: г. Самарканд, улица Рудаки, 217<br />
      Телефон: <a href="tel:+998995981010">+998 99 598 10 10</a>`,
    sec2Title: "2. Состав собираемых данных",
    sec2Intro: "При отправке формы записи на приём на нашем сайте мы собираем:",
    sec2List: [
      "<strong>Имя</strong> — для корректного обращения к вам",
      "<strong>Номер телефона</strong> — для связи с вами и подтверждения записи"
    ],
    sec2Outro: "Мы <strong>не собираем</strong> адреса электронной почты, платёжные данные, данные о местоположении и сведения о состоянии здоровья через форму на сайте.",
    sec3Title: "3. Цель и правовое основание обработки",
    sec3Intro: "Ваши данные обрабатываются исключительно в следующих целях:",
    sec3List: [
      "Запись на приём и его подтверждение",
      "Связь с вами как с действующим или потенциальным пациентом клиники"
    ],
    sec3Legal: "Правовое основание — <strong>явное согласие</strong> субъекта персональных данных, данное посредством установки отметки в форме записи, в соответствии с Законом Республики Узбекистан «О персональных данных» (ЗРУ-547, 2019 г.).",
    sec4Title: "4. Хранение и защита данных",
    sec4Body1: "Заявки, поданные через форму, поступают в защищённый Telegram-канал, доступный только сотрудникам клиники, ответственным за запись пациентов. Данные не сохраняются в базах данных третьих сторон.",
    sec4Body2: "Срок хранения: персональные данные хранятся только в течение периода, необходимого для связи с пациентом и оказания медицинских услуг.",
    sec5Title: "5. Передача данных третьим лицам",
    sec5Body: "Ваши персональные данные <strong>не передаются, не продаются и не раскрываются</strong> третьим лицам. Они не используются в рекламных, маркетинговых или иных коммерческих целях.",
    sec6Title: "6. Ваши права",
    sec6Intro: "Вы имеете право:",
    sec6List: [
      "<strong>Доступ</strong> — запросить информацию о персональных данных, которые мы обрабатываем",
      "<strong>Исправление</strong> — потребовать исправления неточных данных",
      "<strong>Удаление</strong> — потребовать удаления ваших данных в любое время",
      "<strong>Отзыв согласия</strong> — отозвать согласие на обработку данных"
    ],
    sec6Outro: "Для реализации любого из перечисленных прав обратитесь к нам по телефону, указанному в разделе 1.",
    sec7Title: "7. Изменения политики",
    sec7Body: "Мы можем периодически обновлять настоящую Политику конфиденциальности. Дата последнего обновления указана в начале страницы.",
    otherLangs: "Эта страница на других языках:",
    backHome: "На главную"
  },
  uz: {
    title: "Maxfiylik siyosati — Lumivis oftalmologiya klinikasi, Samarqand",
    description: "Lumivis klinikasining maxfiylik siyosati. Shaxsiy ma'lumotlaringizni qanday yig'ishimiz va himoya qilishimiz haqida bilib oling.",
    h1: "Maxfiylik siyosati",
    meta: "Oxirgi yangilanish: 2026-yil sentabr",
    sec1Title: "1. Shaxsiy ma'lumotlar operatori",
    sec1Body: `Shaxsiy ma'lumotlar operatori:<br />
      <strong>"Lumivis" oftalmologiya klinikasi</strong><br />
      Manzil: Samarqand shahri, Ro'dakiy ko'chasi, 217<br />
      Telefon: <a href="tel:+998995981010">+998 99 598 10 10</a>`,
    sec2Title: "2. Yig'iladigan ma'lumotlar tarkibi",
    sec2Intro: "Saytimizdagi qabulga yozilish formasini to'ldirganda quyidagi ma'lumotlar yig'iladi:",
    sec2List: [
      "<strong>Ism</strong> — sizga to'g'ri murojaat qilish uchun",
      "<strong>Telefon raqami</strong> — siz bilan bog'lanish va qabulni tasdiqlash uchun"
    ],
    sec2Outro: "Biz sayt shakli orqali elektron pochta manzillari, to'lov ma'lumotlari yoki salomatlik holati haqidagi ma'lumotlarni <strong>yig'maymiz</strong>.",
    sec3Title: "3. Qayta ishlashning maqsadi va huquqiy mezonlari",
    sec3Intro: "Ma'lumotlaringiz faqat quyidagi maqsadlarda qayta ishlanadi:",
    sec3List: [
      "Qabulga yozish va uni tasdiqlash",
      "Klinika bemori sifatida siz bilan bog'lanish"
    ],
    sec3Legal: "Huquqiy asos — O'zbekiston Respublikasining «Shaxsga doir ma'lumotlar to'g'risida»gi Qonuniga (O'RQ-547, 2019-yil) muvofiq, shakldagi rozilik belgisini qo'yish orqali berilgan <strong>aniq rozilik</strong>.",
    sec4Title: "4. Ma'lumotlarni saqlash va himoya qilish",
    sec4Body1: "Shakl orqali yuborilgan arizalar faqat bemorlarni ro'yxatga olish uchun mas'ul xodimlarga ochiq bo'lgan xavfsiz Telegram-kanalga tushadi. Ma'lumotlar uchinchi shaxslar bazasida saqlanmaydi.",
    sec4Body2: "Saqlash muddati: shaxsiy ma'lumotlar faqat bemor bilan bog'lanish va tibbiy xizmat ko'rsatish uchun zarur bo'lgan davr mobaynida saqlanadi.",
    sec5Title: "5. Ma'lumotlarni uchinchi shaxslarga berish",
    sec5Body: "Sizning shaxsiy ma'lumotlaringiz uchinchi shaxslarga <strong>berilmaydi, sotilmaydi va oshkor etilmaydi</strong>. Ular reklama yoki tijorat maqsadlarida ishlatilmaydi.",
    sec6Title: "6. Sizning huquqlaringiz",
    sec6Intro: "Siz quyidagi huquqlarga egasiz:",
    sec6List: [
      "<strong>Kirish</strong> — biz ishlaydigan shaxsiy ma'lumotlar haqida ma'lumot so'rash",
      "<strong>Tuzatish</strong> — noaniq ma'lumotlarni tuzatishni talab qilish",
      "<strong>O'chirish</strong> — ma'lumotlaringizni o'chirishni talab qilish",
      "<strong>Rozilikni qaytarib olish</strong> — ma'lumotlarni qayta ishlashga berilgan rozilikni bekor qilish"
    ],
    sec6Outro: "Ushbu huquqlardan foydalanish uchun 1-bo'limda ko'rsatilgan telefon raqami orqali biz bilan bog'laning.",
    sec7Title: "7. Siyosatdagi o'zgarishlar",
    sec7Body: "Ushbu Maxfiylik siyosati vaqti-vaqti bilan yangilanishi mumkin. Oxirgi yangilanish sanasi sahifaning boshida ko'rsatilgan.",
    otherLangs: "Ushbu sahifa boshqa tillarda:",
    backHome: "Bosh sahifaga"
  },
  en: {
    title: "Privacy Policy — Lumivis Eye Clinic, Samarkand",
    description: "Privacy Policy of Lumivis Eye Clinic. Learn how we collect, use, and protect your personal data.",
    h1: "Privacy Policy",
    meta: "Last updated: September 2026",
    sec1Title: "1. Data Controller",
    sec1Body: `The data controller is:<br />
      <strong>Lumivis Ophthalmology Clinic</strong><br />
      Address: 217 Rudaki Street, Samarkand<br />
      Phone: <a href="tel:+998995981010">+998 99 598 10 10</a>`,
    sec2Title: "2. Personal Data Collected",
    sec2Intro: "When submitting the appointment booking form on our website, we collect:",
    sec2List: [
      "<strong>Name</strong> — to address you correctly",
      "<strong>Phone Number</strong> — to contact you and confirm your appointment"
    ],
    sec2Outro: "We <strong>do not collect</strong> email addresses, payment data, location data, or health records via the website form.",
    sec3Title: "3. Purpose and Legal Basis",
    sec3Intro: "Your data is processed exclusively for the following purposes:",
    sec3List: [
      "Scheduling and confirming appointments",
      "Communicating with you as a current or prospective patient of the clinic"
    ],
    sec3Legal: "Legal basis — <strong>explicit consent</strong> provided by checking the box in the booking form, in accordance with the Law of the Republic of Uzbekistan 'On Personal Data' (ZRU-547, 2019).",
    sec4Title: "4. Data Storage and Protection",
    sec4Body1: "Form submissions are sent to a secure Telegram channel accessible only to authorized clinic staff. Data is not stored in third-party databases.",
    sec4Body2: "Retention period: Personal data is retained only for the period necessary to arrange appointments and deliver medical services.",
    sec5Title: "5. Data Disclosure to Third Parties",
    sec5Body: "Your personal data is <strong>never shared, sold, or disclosed</strong> to third parties. It is not used for advertising or marketing purposes.",
    sec6Title: "6. Your Rights",
    sec6Intro: "You have the right to:",
    sec6List: [
      "<strong>Access</strong> — request information about your stored data",
      "<strong>Rectification</strong> — request correction of inaccurate data",
      "<strong>Erasure</strong> — request deletion of your data at any time",
      "<strong>Withdrawal</strong> — withdraw your consent at any time"
    ],
    sec6Outro: "To exercise any of these rights, please contact us via the phone number listed in Section 1.",
    sec7Title: "7. Policy Updates",
    sec7Body: "We may periodically update this Privacy Policy. The date of the last update is displayed at the top of the page.",
    otherLangs: "This page in other languages:",
    backHome: "Back to Home"
  }
};

const t = content[lang] || content.ru;
---

<BaseLayout
  title={t.title}
  description={t.description}
  lang={lang}
>
  <SiteHeader lang={lang} />

  <main id="main-content" class="privacy-page">
    <div class="container privacy-container">

      <h1 class="privacy-title" id="privacy-h1">{t.h1}</h1>
      <p class="privacy-meta"><time datetime="2026-09-01">{t.meta}</time></p>

      <section class="privacy-section">
        <h2>{t.sec1Title}</h2>
        <p Fragment set:html={t.sec1Body} />
      </section>

      <section class="privacy-section">
        <h2>{t.sec2Title}</h2>
        <p>{t.sec2Intro}</p>
        <ul>
          {t.sec2List.map((item) => (
            <li Fragment set:html={item} />
          ))}
        </ul>
        <p Fragment set:html={t.sec2Outro} />
      </section>

      <section class="privacy-section">
        <h2>{t.sec3Title}</h2>
        <p>{t.sec3Intro}</p>
        <ul>
          {t.sec3List.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p Fragment set:html={t.sec3Legal} />
      </section>

      <section class="privacy-section">
        <h2>{t.sec4Title}</h2>
        <p>{t.sec4Body1}</p>
        <p>{t.sec4Body2}</p>
      </section>

      <section class="privacy-section">
        <h2>{t.sec5Title}</h2>
        <p Fragment set:html={t.sec5Body} />
      </section>

      <section class="privacy-section">
        <h2>{t.sec6Title}</h2>
        <p>{t.sec6Intro}</p>
        <ul>
          {t.sec6List.map((item) => (
            <li Fragment set:html={item} />
          ))}
        </ul>
        <p>{t.sec6Outro}</p>
      </section>

      <section class="privacy-section">
        <h2>{t.sec7Title}</h2>
        <p>{t.sec7Body}</p>
      </section>

      <div class="privacy-lang-links">
        <span>{t.otherLangs}</span>
        {lang !== "ru" && <a href="/ru/privacy">Русский</a>}
        {lang !== "uz" && <a href="/uz/privacy">O'zbek</a>}
        {lang !== "en" && <a href="/en/privacy">English</a>}
      </div>

      <div class="privacy-back">
        <a href={`/${lang}/`} class="btn btn--outline">&larr; {t.backHome}</a>
      </div>

    </div>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
.privacy-page {
  padding-block: clamp(3rem, 8vw, 6rem);
  background: var(--c-white);
  min-height: 60vh;
}

.privacy-container {
  max-width: 720px;
}

.privacy-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  color: var(--c-ink);
  margin-bottom: 0.5rem;
}

.privacy-meta {
  font-size: 0.875rem;
  color: var(--c-muted);
  margin-bottom: clamp(2rem, 5vw, 3.5rem);
  border-bottom: 1px solid var(--c-border);
  padding-bottom: 1rem;
}

.privacy-section {
  margin-bottom: 2.5rem;
}

.privacy-section h2 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--c-ink);
  margin-bottom: 0.75rem;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid var(--c-sky-pale);
}

.privacy-section p,
.privacy-section li {
  font-size: 0.95rem;
  color: var(--c-text);
  line-height: 1.75;
}

.privacy-section ul {
  padding-left: 1.5rem;
  margin-block: 0.5rem;
}

.privacy-section a {
  color: var(--c-sky);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.privacy-lang-links {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  font-size: 0.85rem;
  color: var(--c-muted);
  margin-bottom: 1.5rem;
}

.privacy-lang-links a {
  color: var(--c-sky);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.privacy-back {
  margin-top: 1.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--c-border);
}
</style>
