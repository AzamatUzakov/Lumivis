---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---

<BaseLayout
  title="Privacy Policy — Lumivis Ophthalmology Clinic, Samarkand"
  description="Privacy Policy of Lumivis Ophthalmology Clinic. Learn how we collect, use and protect your personal data."
>
  <SiteHeader />
  <main id="main-content" class="privacy-page">
    <div class="container privacy-container">

      <h1 class="privacy-title">Privacy Policy</h1>
      <p class="privacy-meta">Last updated: <time datetime="2026-09-01">September 2026</time></p>

      <section class="privacy-section">
        <h2>1. Data Controller</h2>
        <p>
          The data controller responsible for processing your personal data is:<br />
          <strong>
            {/* TODO [ЗАПОЛНИТЬ]: Legal name of the clinic, e.g. "Lumivis LLC" */}
            [FILL IN: legal entity name]
          </strong><br />
          Address: Samarkand, Uzbekistan
          {/* TODO [ЗАПОЛНИТЬ]: Full street address */}
          <br />
          Phone: <a href="tel:+998995981010">+998 99 598 10 10</a><br />
          {/* TODO [ЗАПОЛНИТЬ]: Data Protection contact email */}
          Email for data requests: [FILL IN: email address]
        </p>
      </section>

      <section class="privacy-section">
        <h2>2. What Data We Collect</h2>
        <p>When you submit the appointment booking form on our website, we collect:</p>
        <ul>
          <li><strong>Name</strong> — to address you correctly</li>
          <li><strong>Phone number</strong> — to contact you and confirm your appointment</li>
        </ul>
        <p>We do <strong>not</strong> collect email addresses, payment information, location data, or any health data through the website form.</p>
      </section>

      <section class="privacy-section">
        <h2>3. Purpose and Legal Basis</h2>
        <p>Your data is processed solely for the following purposes:</p>
        <ul>
          <li>Scheduling and confirming your appointment at Lumivis clinic</li>
          <li>Contacting you as a current or prospective patient</li>
        </ul>
        <p>
          The legal basis is your <strong>explicit consent</strong> given via the checkbox on the booking form,
          pursuant to the Law of the Republic of Uzbekistan "On Personal Data" (No. ZRU-547, 2019).
        </p>
      </section>

      <section class="privacy-section">
        <h2>4. Data Storage and Security</h2>
        <p>
          Submitted booking requests are received via a secure Telegram Bot channel accessible only to
          clinic staff responsible for scheduling. We do not store your data in any third-party database
          beyond the message received.
        </p>
        <p>
          {/* TODO [ЗАПОЛНИТЬ]: Specify retention period, e.g. "Data is retained for up to 12 months from the date of receipt, after which it is deleted." */}
          Data retention period: [FILL IN: specify retention period]
        </p>
      </section>

      <section class="privacy-section">
        <h2>5. Data Sharing</h2>
        <p>
          Your personal data is <strong>not shared, sold, or disclosed</strong> to any third parties.
          It is not used for marketing, advertising, or profiling purposes.
          Only authorised clinic staff responsible for appointment scheduling have access to your data.
        </p>
      </section>

      <section class="privacy-section">
        <h2>6. Your Rights</h2>
        <p>You have the right to:</p>
        <ul>
          <li><strong>Access</strong> — request a copy of the personal data we hold about you</li>
          <li><strong>Rectification</strong> — request correction of inaccurate data</li>
          <li><strong>Erasure</strong> — request deletion of your data at any time</li>
          <li><strong>Withdrawal of consent</strong> — revoke your consent at any time without affecting prior processing</li>
        </ul>
        <p>
          To exercise any of these rights, please contact us by phone or email listed in Section 1.
          We will respond within 10 business days.
        </p>
      </section>

      <section class="privacy-section">
        <h2>7. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. The date at the top of this page
          reflects the date of the most recent revision. We encourage you to review this page periodically.
        </p>
      </section>

      <div class="privacy-back">
        <a href="/" class="btn btn--outline">&larr; Back to Main Page</a>
      </div>

    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
.privacy-page {
  padding-block: clamp(3rem, 8vw, 6rem);
  background: var(--c-white);
  min-height: 60vh;
}

.privacy-container {
  max-width: 720px;
}

.privacy-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  color: var(--c-ink);
  margin-bottom: 0.5rem;
}

.privacy-meta {
  font-size: 0.875rem;
  color: var(--c-muted);
  margin-bottom: clamp(2rem, 5vw, 3.5rem);
  border-bottom: 1px solid var(--c-border);
  padding-bottom: 1rem;
}

.privacy-section {
  margin-bottom: 2.5rem;
}

.privacy-section h2 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--c-ink);
  margin-bottom: 0.75rem;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid var(--c-sky-pale);
}

.privacy-section p,
.privacy-section li {
  font-size: 0.95rem;
  color: var(--c-text);
  line-height: 1.75;
}

.privacy-section ul {
  padding-left: 1.5rem;
  margin-block: 0.5rem;
}

.privacy-section a {
  color: var(--c-sky);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.privacy-back {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--c-border);
}
</style>
