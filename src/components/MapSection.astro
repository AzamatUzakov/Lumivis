---
// MapSection v2 — editorial map & contacts section
---

<section class="map-section section" id="contacts">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow eyebrow--amber">Локация</span>
      <h2 data-i18n="map.title">Как нас найти</h2>
    </div>

    <div class="map-section__inner">
      <!-- Map embed -->
      <div class="map-section__map">
        <iframe
          src="https://yandex.uz/map-widget/v1/org/lumivis/194206637683/?ll=66.976016,39.666194&z=16&lang=ru_RU"
          width="100%"
          height="100%"
          frameborder="0"
          title="Карта клиники Lumivis в Самарканде"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>

      <!-- Contact details -->
      <div class="map-section__details">
        <div class="contact-block">
          <div class="contact-block__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <p class="contact-block__label" data-i18n="map.address.label">Адрес</p>
            <p class="contact-block__value" data-i18n="map.address">г. Самарканд, Узбекистан</p>
          </div>
        </div>

        <div class="contact-block">
          <div class="contact-block__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div>
            <p class="contact-block__label" data-i18n="map.hours.label">Режим работы</p>
            <p class="contact-block__value" data-i18n="map.hours">Понедельник–Суббота: 09:00–17:00</p>
          </div>
        </div>

        <div class="contact-block">
          <div class="contact-block__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.67 10.37a19.79 19.79 0 01-3.07-8.67A2 2 0 012.58 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.53a16 16 0 006.56 6.56l.9-.9a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </div>
          <div>
            <p class="contact-block__label" data-i18n="map.phone.label">Телефон</p>
            <a href="tel:+998995981010" class="contact-block__value contact-block__phone">
              +998 99 598 10 10
            </a>
          </div>
        </div>

        <!-- Social Buttons -->
        <div class="contact-socials">
          <a
            href="https://t.me/NKernel"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline"
            aria-label="Telegram"
          >
            Telegram @NKernel
          </a>
          <a
            href="https://www.instagram.com/abduqayyum_ocularist/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline"
            aria-label="Instagram"
          >
            Instagram
          </a>
        </div>

        <a
          href="https://yandex.uz/maps/org/lumivis/194206637683/?ll=66.976016%2C39.666194&z=16"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary map-route-btn"
          data-i18n="map.route"
        >
          Построить маршрут
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.map-section__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-8);
  align-items: start;
}

.map-section__map {
  border-radius: var(--r-lg);
  overflow: hidden;
  border: 1px solid var(--c-border-lt);
  height: 380px;
  background: var(--c-stone);
}

.map-section__map iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

.map-section__details {
  display: flex;
  flex-direction: column;
  gap: var(--s-5);
  background: var(--c-white);
  padding: var(--s-8);
  border-radius: var(--r-lg);
  border: 1px solid var(--c-border-lt);
}

.contact-block {
  display: flex;
  align-items: flex-start;
  gap: var(--s-4);
}

.contact-block__icon {
  width: 40px;
  height: 40px;
  background: var(--c-stone);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-navy);
  flex-shrink: 0;
}

.contact-block__label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--c-amber);
  margin-bottom: 2px;
}

.contact-block__value {
  font-size: 0.95rem;
  color: var(--c-body);
  line-height: 1.5;
}

.contact-block__phone {
  font-family: var(--font-display);
  font-size: 1.3rem;
  color: var(--c-navy);
  transition: color var(--t-fast);
}

.contact-block__phone:hover {
  color: var(--c-amber);
}

.contact-socials {
  display: flex;
  gap: var(--s-3);
  flex-wrap: wrap;
  padding-top: var(--s-2);
}

.map-route-btn {
  align-self: flex-start;
  margin-top: var(--s-2);
}

@media (min-width: 900px) {
  .map-section__inner {
    grid-template-columns: 1.5fr 1fr;
  }

  .map-section__map {
    height: 480px;
  }
}
</style>
