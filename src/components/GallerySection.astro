---
// GallerySection — 11 process photos in CSS multi-column masonry grid
import { Image } from "astro:assets";
import g1 from "../assets/gallery/IMG_0316.JPG";
import g2 from "../assets/gallery/IMG_0322.JPG";
import g3 from "../assets/gallery/IMG_0323.JPG";
import g4 from "../assets/gallery/IMG_0325.JPG";
import g5 from "../assets/gallery/IMG_0348.JPG";
import g6 from "../assets/gallery/IMG_0351.JPG";
import g7 from "../assets/gallery/IMG_0353.JPG";
import g8 from "../assets/gallery/amo_atos.jpg";
import g9 from "../assets/gallery/rucheyok.jpg";
import g10 from "../assets/gallery/gezatone.jpg";
import g11 from "../assets/gallery/speckl.jpg";

const photos = [
  { src: g1, alt: "Детская диагностика зрения" },
  { src: g7, alt: "Обследование пациента" },
  { src: g2, alt: "Проверка зрения у ребёнка" },
  { src: g10, alt: "Свето-магнитотерапия очками Gezatone" },
  { src: g3, alt: "Офтальмологическое обследование" },
  { src: g9, alt: "Тренировка зрения на аппарате Ручеёк" },
  { src: g4, alt: "Диагностика на аппарате" },
  { src: g11, alt: "Лазерная стимуляция сетчатки" },
  { src: g5, alt: "Приём взрослого пациента" },
  { src: g6, alt: "Консультация офтальмолога" },
  { src: g8, alt: "Магнитотерапия на аппарате АМО-АТОС" },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <div class="section-header reveal">
      <h2 data-i18n="gallery.title">Как проходит приём</h2>
      <p data-i18n="gallery.subtitle">Тепло, спокойно и безболезненно — для маленьких и взрослых пациентов</p>
    </div>

    <div class="gallery__masonry">
      {photos.map((photo, i) => (
        <div class="gallery__item reveal-fade">
          <Image
            src={photo.src}
            alt={photo.alt}
            data-i18n-alt={`gallery.${i + 1}.alt`}
            class="gallery__img"
            width={800}
            quality={78}
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <div class="gallery__overlay" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.gallery__masonry {
  columns: 2;
  -webkit-columns: 2;
  column-count: 2;
  -webkit-column-count: 2;
  column-gap: 12px;
  -webkit-column-gap: 12px;
  width: 100%;
}

@media (min-width: 640px) {
  .gallery__masonry {
    column-gap: 16px;
    -webkit-column-gap: 16px;
  }
}

@media (min-width: 960px) {
  .gallery__masonry {
    columns: 3;
    -webkit-columns: 3;
    column-count: 3;
    -webkit-column-count: 3;
    column-gap: 20px;
    -webkit-column-gap: 20px;
  }
}

.gallery__item {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  margin-bottom: 12px;
  position: relative;
  border-radius: var(--r-md, 14px);
  overflow: hidden;
  box-shadow: 0 3px 12px rgba(11, 42, 107, 0.06);
  background: #ffffff;
  transition: transform var(--t-base, 220ms ease), box-shadow var(--t-base, 220ms ease);
}

@media (min-width: 640px) {
  .gallery__item {
    margin-bottom: 16px;
    border-radius: var(--r-md, 16px);
  }
}

@media (min-width: 960px) {
  .gallery__item {
    margin-bottom: 20px;
  }
}

.gallery__item:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(11, 42, 107, 0.12);
}

.gallery__img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  transition: transform var(--t-slow, 350ms ease), filter var(--t-slow, 350ms ease);
  filter: brightness(0.98) saturate(0.97);
}

.gallery__item:hover .gallery__img {
  transform: scale(1.02);
  filter: brightness(1.02) saturate(1.05);
}

.gallery__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(11,42,107,0.20) 100%);
  pointer-events: none;
  transition: opacity var(--t-base, 220ms ease);
  opacity: 0;
}

.gallery__item:hover .gallery__overlay {
  opacity: 1;
}
</style>
