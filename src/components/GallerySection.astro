---
// GallerySection — 11 process photos in CSS multi-column masonry grid
import { Image } from "astro:assets";
import GalleryInfoModal from "./GalleryInfoModal.astro";
import g1 from "../assets/gallery/IMG_0316.JPG";
import g2 from "../assets/gallery/IMG_0322.JPG";
import g3 from "../assets/gallery/IMG_0323.JPG";
import g4 from "../assets/gallery/IMG_0325.JPG";
import g5 from "../assets/gallery/IMG_0348.JPG";
import g6 from "../assets/gallery/IMG_0351.JPG";
import g7 from "../assets/gallery/IMG_0353.JPG";
import g8 from "../assets/gallery/amo_atos.jpg";
import g9 from "../assets/gallery/rucheyok.jpg";
import g10 from "../assets/gallery/gezatone.jpg";
import g11 from "../assets/gallery/speckl.jpg";
import { useTranslations, type SupportedLang } from "../i18n/utils";

interface Props {
  lang?: SupportedLang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);

const photos = [
  { id: 1, src: g1 },
  { id: 2, src: g7 },
  { id: 3, src: g2 },
  { id: 4, src: g10 },
  { id: 5, src: g3 },
  { id: 6, src: g9 },
  { id: 7, src: g4 },
  { id: 8, src: g11 },
  { id: 9, src: g5 },
  { id: 10, src: g6 },
  { id: 11, src: g8 },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <div class="section-header reveal">
      <h2 data-i18n="gallery.title">{t("gallery.title")}</h2>
      <p data-i18n="gallery.subtitle">{t("gallery.subtitle")}</p>
    </div>

    <div class="gallery__masonry">
      {photos.map((photo, i) => {
        const altKey = `gallery.${i + 1}.alt`;
        const altText = t(altKey);

        return (
          <div
            class="gallery__item reveal-fade"
            data-open-gallery-modal={i + 1}
            role="button"
            tabindex="0"
            aria-label={altText}
          >
            <Image
              src={photo.src}
              alt={altText}
              data-i18n-alt={altKey}
              class="gallery__img"
              width={800}
              quality={78}
              format="webp"
              loading="lazy"
              decoding="sync"
            />
            <div class="gallery__overlay" aria-hidden="true"></div>
            <div class="card-arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"/>
                <polyline points="7 7 17 7 17 17"/>
              </svg>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <GalleryInfoModal lang={lang} />
</section>

<style>
.gallery__masonry {
  columns: 2;
  -webkit-columns: 2;
  column-count: 2;
  -webkit-column-count: 2;
  column-gap: 12px;
  -webkit-column-gap: 12px;
  width: 100%;
}

@media (min-width: 640px) {
  .gallery__masonry {
    column-gap: 16px;
    -webkit-column-gap: 16px;
  }
}

@media (min-width: 960px) {
  .gallery__masonry {
    columns: 3;
    -webkit-columns: 3;
    column-count: 3;
    -webkit-column-count: 3;
    column-gap: 20px;
    -webkit-column-gap: 20px;
  }
}

.gallery__item {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  margin-bottom: 12px;
  position: relative;
  border-radius: var(--r-md, 14px);
  overflow: hidden;
  box-shadow: 0 3px 12px rgba(11, 42, 107, 0.06);
  background: #ffffff;
  cursor: pointer;
  transition: transform var(--t-base, 220ms ease), box-shadow var(--t-base, 220ms ease);
}

.gallery__item:focus-visible {
  outline: 2px solid var(--c-sky, #2e86f5);
  outline-offset: 3px;
}

@media (min-width: 640px) {
  .gallery__item {
    margin-bottom: 16px;
    border-radius: var(--r-md, 16px);
  }
}

@media (min-width: 960px) {
  .gallery__item {
    margin-bottom: 20px;
  }
}

.gallery__item:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(11, 42, 107, 0.12);
}

.gallery__img {
  width: 100%;
  height: auto;
  display: block;
  -webkit-transform: translateZ(0);
  transition: transform var(--t-slow, 350ms ease), filter var(--t-slow, 350ms ease);
  filter: brightness(0.98) saturate(0.97);
}

.gallery__item:hover .gallery__img {
  transform: scale(1.02);
  filter: brightness(1.02) saturate(1.05);
}

.gallery__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(11,42,107,0.30) 100%);
  pointer-events: none;
  transition: opacity var(--t-base, 220ms ease);
  opacity: 0.6;
}

.gallery__item:hover .gallery__overlay {
  opacity: 1;
}

.card-arrow {
  position: absolute;
  bottom: 12px;
  right: 12px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #0b2a6b;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(11, 42, 107, 0.16);
  transition: transform 220ms ease, background 220ms ease, color 220ms ease;
  pointer-events: none;
  z-index: 2;
}

.gallery__item:hover .card-arrow {
  transform: translate(2px, -2px) scale(1.05);
  background: #2e86f5;
  color: #ffffff;
}

@media (max-width: 599px) {
  .card-arrow {
    width: 28px;
    height: 28px;
    bottom: 8px;
    right: 8px;
  }
  .card-arrow svg {
    width: 15px;
    height: 15px;
  }
}
</style>
