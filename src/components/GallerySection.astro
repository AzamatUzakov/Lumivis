---
// GallerySection v2 — editorial grid layout for process photos
const photos = [
  { src: "/IMG_0316.JPG", alt: "Детская диагностика зрения" },
  { src: "/IMG_0322.JPG", alt: "Проверка зрения у ребёнка" },
  { src: "/IMG_0323.JPG", alt: "Офтальмологическое обследование" },
  { src: "/IMG_0325.JPG", alt: "Диагностика на аппарате" },
  { src: "/IMG_0348.JPG", alt: "Приём взрослого пациента" },
  { src: "/IMG_0351.JPG", alt: "Консультация офтальмолога" },
  { src: "/IMG_0353.JPG", alt: "Обследование пациента" },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow eyebrow--amber">Рабочий процесс</span>
      <h2 data-i18n="gallery.title">Как проходит приём</h2>
      <p data-i18n="gallery.subtitle">Тепло, спокойно и безболезненно — для маленьких и взрослых пациентов</p>
    </div>

    <div class="gallery__grid">
      {photos.map((photo, i) => (
        <div class={`gallery__item gallery__item--${i + 1}`}>
          <img
            src={photo.src}
            alt={photo.alt}
            class="gallery__img"
            loading="lazy"
            decoding="async"
            width="600"
            height="450"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.gallery__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-4);
}

.gallery__item {
  position: relative;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--c-stone);
  border: 1px solid var(--c-border-lt);
}

.gallery__img {
  width: 100%;
  height: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: transform var(--t-base);
  filter: contrast(1.02);
}

.gallery__item:hover .gallery__img {
  transform: scale(1.03);
}

@media (min-width: 768px) {
  .gallery__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1100px) {
  .gallery__grid {
    grid-template-columns: repeat(4, 1fr);
  }
  .gallery__item--1 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .gallery__item--1 .gallery__img {
    aspect-ratio: auto;
  }
}
</style>
