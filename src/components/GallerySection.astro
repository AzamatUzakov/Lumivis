---
// GallerySection — 7 process photos in masonry-style grid
import { Image } from "astro:assets";
import g1 from "../assets/gallery/IMG_0316.JPG";
import g2 from "../assets/gallery/IMG_0322.JPG";
import g3 from "../assets/gallery/IMG_0323.JPG";
import g4 from "../assets/gallery/IMG_0325.JPG";
import g5 from "../assets/gallery/IMG_0348.JPG";
import g6 from "../assets/gallery/IMG_0351.JPG";
import g7 from "../assets/gallery/IMG_0353.JPG";

const photos = [
  { src: g1, alt: "Детская диагностика зрения" },
  { src: g2, alt: "Проверка зрения у ребёнка" },
  { src: g3, alt: "Офтальмологическое обследование" },
  { src: g4, alt: "Диагностика на аппарате" },
  { src: g5, alt: "Приём взрослого пациента" },
  { src: g6, alt: "Консультация офтальмолога" },
  { src: g7, alt: "Обследование пациента" },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <div class="section-header reveal">
      <h2 data-i18n="gallery.title">Как проходит приём</h2>
      <p data-i18n="gallery.subtitle">Тепло, спокойно и безболезненно — для маленьких и взрослых пациентов</p>
    </div>

    <div class="gallery__grid">
      {photos.map((photo, i) => (
        <div class={`gallery__item gallery__item--${i + 1} reveal-fade`}>
          <Image
            src={photo.src}
            alt={photo.alt}
            data-i18n-alt={`gallery.${i + 1}.alt`}
            class="gallery__img"
            width={800}
            quality={76}
            format="webp"
            loading="lazy"
            decoding="async"
          />
          <div class="gallery__overlay" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.gallery__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-auto-rows: 200px;
  gap: var(--s-3);
}

.gallery__item {
  position: relative;
  border-radius: var(--r-md);
  overflow: hidden;
  cursor: pointer;
}

/* Varied heights for masonry feel */
.gallery__item--1 { grid-row: span 2; }
.gallery__item--5 { grid-row: span 2; }

.gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--t-slow), filter var(--t-slow);
  filter: brightness(0.97) saturate(0.95);
}

.gallery__item:hover .gallery__img {
  transform: scale(1.04);
  filter: brightness(1.02) saturate(1.05);
}

.gallery__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(11,42,107,0.25) 100%);
  transition: opacity var(--t-base);
  opacity: 0;
}

.gallery__item:hover .gallery__overlay {
  opacity: 1;
}

@media (min-width: 768px) {
  .gallery__grid {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
  }

  .gallery__item--1 { grid-row: span 2; }
  .gallery__item--3 { grid-row: span 2; grid-column: span 1; }
  .gallery__item--5 { grid-row: span 1; }
  .gallery__item--6 { grid-row: span 2; }
}

@media (min-width: 1100px) {
  .gallery__grid {
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
  }

  .gallery__item--1 { grid-column: span 2; grid-row: span 2; }
  .gallery__item--3 { grid-row: span 2; }
  .gallery__item--6 { grid-column: span 2; }
}
</style>
