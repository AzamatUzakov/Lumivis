---
// ServicesSection — 8 service cards
---

<section class="services section section--surface" id="services">
  <div class="container">
    <div class="section-header">
      <h2 data-i18n="services.title">Наши услуги</h2>
      <p data-i18n="services.subtitle">Полный спектр офтальмологической помощи взрослым и детям</p>
    </div>

    <div class="services__grid">

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.1.title">Диагностика зрения</h3>
          <p data-i18n="services.1.text">Авторефрактометрия, биомикроскопия, тонометрия, периметрия — комплексное обследование</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta" aria-label="Записаться на диагностику зрения">Записаться</a>
      </article>

      <article class="service-card service-card--accent">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2v4M12 18v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M2 12h4M18 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.2.title">Ретинопатия недоношенных</h3>
          <p data-i18n="services.2.text">Скрининг, наблюдение и лечение РН — единственная клиника в Самарканде</p>
        </div>
        <a href="#retinopathy" class="service-card__link" data-i18n="services.cta" aria-label="Подробнее о ретинопатии">Записаться</a>
      </article>

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.3.title">Лечение косоглазия</h3>
          <p data-i18n="services.3.text">Аппаратное лечение и хирургическая коррекция косоглазия у детей и взрослых</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta">Записаться</a>
      </article>

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M4.5 6.375a4.125 4.125 0 118.25 0 4.125 4.125 0 01-8.25 0zM14.25 8.625a3.375 3.375 0 116.75 0 3.375 3.375 0 01-6.75 0zM1.5 19.125a7.125 7.125 0 0114.25 0v.003"/>
            <path d="M20.25 15c1.66 0 3 1.34 3 3 0 .414-.084.809-.234 1.17"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.4.title">Лечение амблиопии</h3>
          <p data-i18n="services.4.text">Комплексное лечение «ленивого глаза» с применением аппаратных методик</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta">Записаться</a>
      </article>

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.5.title">Детская офтальмология</h3>
          <p data-i18n="services.5.text">Диагностика и лечение нарушений зрения у детей с первых недель жизни</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta">Записаться</a>
      </article>

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="4"/>
            <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/>
            <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/>
            <line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/>
            <line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.6.title">Подбор очков и линз</h3>
          <p data-i18n="services.6.text">Точный подбор корректирующей оптики для взрослых и детей</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta">Записаться</a>
      </article>

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.7.title">Синдром сухого глаза</h3>
          <p data-i18n="services.7.text">Диагностика и комплексное лечение синдрома сухого глаза</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta">Записаться</a>
      </article>

      <article class="service-card">
        <div class="service-card__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
          </svg>
        </div>
        <div class="service-card__body">
          <h3 data-i18n="services.8.title">Промывание слёзных путей</h3>
          <p data-i18n="services.8.text">Лечение непроходимости слёзных путей, в том числе у новорождённых</p>
        </div>
        <a href="#contacts" class="service-card__link" data-i18n="services.cta">Записаться</a>
      </article>

    </div>
  </div>
</section>

<style>
.services__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-4);
}

.service-card {
  background: var(--c-white);
  border-radius: var(--r-md);
  padding: var(--s-6);
  box-shadow: var(--shadow-card);
  display: grid;
  grid-template-columns: 52px 1fr auto;
  align-items: start;
  gap: var(--s-4);
  transition: transform var(--t-base), box-shadow var(--t-base);
  border-left: 3px solid transparent;
}

.service-card:hover {
  box-shadow: var(--shadow-card-hover);
  border-left-color: var(--c-sky);
}

.service-card--accent {
  border-left-color: var(--c-teal);
  background: linear-gradient(135deg, rgba(13,148,136,0.03) 0%, var(--c-white) 40%);
}

.service-card--accent:hover {
  border-left-color: var(--c-teal);
}

.service-card__icon {
  width: 52px;
  height: 52px;
  background: rgba(46, 134, 245, 0.08);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-sky);
  flex-shrink: 0;
  transition: background var(--t-fast);
}

.service-card--accent .service-card__icon {
  background: rgba(13, 148, 136, 0.1);
  color: var(--c-teal);
}

.service-card:hover .service-card__icon {
  background: rgba(46, 134, 245, 0.14);
}

.service-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.service-card__body h3 {
  font-size: 0.95rem;
  color: var(--c-ink);
  font-weight: 700;
}

.service-card__body p {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--c-muted);
}

.service-card__link {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--c-sky);
  white-space: nowrap;
  padding: 0.35rem 0.8rem;
  border: 1px solid var(--c-sky-pale);
  border-radius: var(--r-full);
  transition: all var(--t-fast);
  align-self: start;
  margin-top: 2px;
}

.service-card__link:hover {
  background: var(--c-sky);
  color: var(--c-white);
  border-color: var(--c-sky);
}

@media (min-width: 640px) {
  .services__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>
