---
import { Image } from "astro:assets";
import rnImg from "../assets/gallery/services_rn.JPG";
import RnInfoModal from "./RnInfoModal.astro";
import { useTranslations, type SupportedLang } from "../i18n/utils";

interface Props {
  lang?: SupportedLang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
---

<section class="services section section--surface" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-header reveal">
      <h2 id="services-title" data-i18n="services.title">{t("services.title")}</h2>
      <p data-i18n="services.subtitle">{t("services.subtitle")}</p>
    </div>

    <ul class="bento-grid">
      <!-- 01: РН (Retinopathy) — 2x2 Bento Feature Block with Photo -->
      <li class="bento-item bento-item--rn reveal">
        <div class="bento-card bento-card--rn">
          <!-- Card Number 01 moved to Top-Right to avoid badge collision -->
          <span class="bento-num bento-num--rn" aria-hidden="true">01</span>

          <!-- Photo Layer with Picture/WebP & Smooth Gradient Mask -->
          <div class="bento-rn-visual" aria-hidden="true">
           <Image
          src={rnImg}
          alt={t("services.rn_img.alt")}
          data-i18n-alt="services.rn_img.alt"
          class="bento-rn-img rn__img"
          width={800}
          height={600}
          quality={80}
          format="webp"
          loading="lazy"
          decoding="async"
        />
            <div class="bento-rn-overlay"></div>
          </div>

          <!-- Background SVG Iris Pattern -->
          <div class="bento-card__bg-pattern" aria-hidden="true">
            <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="200" cy="200" r="60" stroke="#2E86F5" stroke-width="1" opacity="0.10"/>
              <circle cx="200" cy="200" r="120" stroke="#2E86F5" stroke-width="1" opacity="0.08"/>
              <circle cx="200" cy="200" r="180" stroke="#2E86F5" stroke-width="0.8" opacity="0.06"/>
              <line x1="200" y1="0" x2="200" y2="400" stroke="#2E86F5" stroke-width="0.6" opacity="0.06"/>
              <line x1="0" y1="200" x2="400" y2="200" stroke="#2E86F5" stroke-width="0.6" opacity="0.06"/>
              <line x1="58" y1="58" x2="342" y2="342" stroke="#2E86F5" stroke-width="0.6" opacity="0.05"/>
              <line x1="342" y1="58" x2="58" y2="342" stroke="#2E86F5" stroke-width="0.6" opacity="0.05"/>
            </svg>
          </div>

          <!-- Text Content Zone (Left ~58% on Desktop/Tablet) -->
          <div class="bento-rn-content">
            <div class="bento-card__rn-header">
              <span class="bento-badge" data-i18n="hero.badge">
                {t("hero.badge")}
              </span>
            </div>

            <div class="bento-card__rn-body">
              <div class="bento-icon bento-icon--rn" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M12 2v2m0 16v2M2 12h2m16 0h2"/>
                </svg>
              </div>
              <h3 class="bento-rn-title" data-i18n="services.2.title">
                {t("services.2.title")}
              </h3>
              <p class="bento-rn-text" data-i18n="services.2.text">
                {t("services.2.text")}
              </p>
            </div>

            <div class="bento-card__rn-footer">
              <button type="button" class="btn btn--primary bento-rn-btn" data-open-rn-modal data-i18n="rn.modal.trigger">
                {t("rn.modal.trigger")}
              </button>
            </div>
          </div>
        </div>
      </li>

      <!-- 02: Диагностика зрения (2x1 on Desktop) -->
      <li class="bento-item bento-item--diag reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive bento-card--diag" aria-label={t("services.1.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                <circle cx="11" cy="11" r="3"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">02</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.1.title">{t("services.1.title")}</h3>
            <p class="bento-text" data-i18n="services.1.text">
              {t("services.1.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 03: Лечение косоглазия (1x1) -->
      <li class="bento-item bento-item--squint reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive" aria-label={t("services.3.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/>
                <circle cx="9.5" cy="12" r="2.5"/>
                <circle cx="14.5" cy="12" r="2.5"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">03</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.3.title">{t("services.3.title")}</h3>
            <p class="bento-text" data-i18n="services.3.text">
              {t("services.3.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 04: Лечение амблиопии (1x1) -->
      <li class="bento-item bento-item--amb reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive" aria-label={t("services.4.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <circle cx="12" cy="12" r="5"/>
                <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">04</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.4.title">{t("services.4.title")}</h3>
            <p class="bento-text" data-i18n="services.4.text">
              {t("services.4.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 05: Детская офтальмология (1x1) -->
      <li class="bento-item bento-item--kids reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive" aria-label={t("services.5.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4"/>
                <path d="M6 21v-2a6 6 0 0 1 12 0v2"/>
                <path d="M12 2v2M8.5 3.5l1 1.5M15.5 3.5l-1 1.5"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">05</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.5.title">{t("services.5.title")}</h3>
            <p class="bento-text" data-i18n="services.5.text">
              {t("services.5.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 06: Подбор очков и линз (1x1) -->
      <li class="bento-item bento-item--glasses reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive" aria-label={t("services.6.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="14" r="4"/>
                <circle cx="18" cy="14" r="4"/>
                <line x1="10" y1="14" x2="14" y2="14"/>
                <path d="M2 13l2.5-5A2 2 0 0 1 6.3 7H7"/>
                <path d="M22 13l-2.5-5A2 2 0 0 0 17.7 7H17"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">06</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.6.title">{t("services.6.title")}</h3>
            <p class="bento-text" data-i18n="services.6.text">
              {t("services.6.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 07: Синдром сухого глаза (1x1) -->
      <li class="bento-item bento-item--dry reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive" aria-label={t("services.7.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                <path d="M12 12a3 3 0 0 0 3-3"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">07</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.7.title">{t("services.7.title")}</h3>
            <p class="bento-text" data-i18n="services.7.text">
              {t("services.7.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 08: Промывание слёзных путей (1x1) -->
      <li class="bento-item bento-item--tear reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive" aria-label={t("services.8.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v12"/>
                <path d="M8 11l4 4 4-4"/>
                <path d="M4 19h16"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">08</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.8.title">{t("services.8.title")}</h3>
            <p class="bento-text" data-i18n="services.8.text">
              {t("services.8.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>

      <!-- 09: Индивидуальное глазное протезирование (2x1 on Desktop) -->
      <li class="bento-item bento-item--prosthesis reveal">
        <a href="#booking-form-section" class="bento-card bento-card--interactive bento-card--prosthesis" aria-label={t("services.9.title")}>
          <div class="bento-card__top">
            <div class="bento-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/>
                <circle cx="12" cy="12" r="3.5"/>
                <circle cx="12" cy="12" r="1" fill="currentColor"/>
              </svg>
            </div>
            <span class="bento-num" aria-hidden="true">09</span>
          </div>

          <div class="bento-card__body">
            <h3 class="bento-title" data-i18n="services.9.title">{t("services.9.title")}</h3>
            <p class="bento-text" data-i18n="services.9.text">
              {t("services.9.text")}
            </p>
          </div>

          <div class="bento-card__arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
        </a>
      </li>
    </ul>

    <!-- Bottom CTA Bar -->
    <div class="services-bottom-cta reveal">
      <p class="services-bottom-cta__text" data-i18n="services.bottom.text">
        {t("services.bottom.text")}
      </p>
      <a href="#booking-form-section" class="btn btn--outline services-bottom-cta__btn" data-i18n="services.bottom.cta">
        {t("services.bottom.cta")}
      </a>
    </div>
  </div>

  <!-- Modal Dialog with ROP Medical Info & Brochure content -->
  <RnInfoModal lang={lang} />
</section>

<style>
/* ── Section Container ── */
.services {
  padding-block: clamp(48px, 7vw, 92px);
  overflow: hidden;
}

/* ── Bento Grid Base ── */
.bento-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 16px;
  width: 100%;
}

/* ── Item Reveal Animation ── */
.bento-item {
  min-width: 0;
  display: flex;
}

/* ── Card Base ── */
.bento-card {
  width: 100%;
  border-radius: 20px;
  position: relative;
  box-sizing: border-box;
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
}

/* Interactive Tiles (02 to 08) */
.bento-card--interactive {
  background: #ffffff;
  border: 1px solid rgba(11, 42, 107, 0.10);
  box-shadow: 0 1px 2px rgba(11, 42, 107, 0.04);
  padding: 16px 18px;
  transition: transform 220ms ease,
              border-color 220ms ease,
              box-shadow 220ms ease,
              background-color 220ms ease;
  min-height: 100%;
}

@media (hover: hover) and (pointer: fine) {
  .bento-card--interactive:hover {
    transform: translateY(-2px);
    border-color: rgba(46, 134, 245, 0.45);
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(11, 42, 107, 0.08);
  }

  .bento-card--interactive:hover .bento-card__arrow {
    transform: translate(3px, -3px);
    color: var(--c-sky);
    opacity: 1;
  }
}

.bento-card--interactive:active {
  transform: scale(0.99);
  background: #f5f9ff;
}

.bento-card:focus-visible,
.bento-rn-btn:focus-visible {
  outline: 2px solid var(--c-sky);
  outline-offset: 3px;
}

/* Top section inside tile (Icon + Number) */
.bento-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.bento-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #eaf2ff;
  color: #2e86f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background var(--t-fast);
}

.bento-num {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  color: #9db0d0;
  letter-spacing: 0.05em;
}

/* Card Typography */
.bento-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.bento-title {
  font-family: var(--font-display);
  font-size: 0.98rem;
  font-weight: 700;
  color: #0b2a6b;
  line-height: 1.35;
  margin: 0;
  overflow-wrap: break-word;
}

.bento-text {
  font-size: 0.82rem;
  color: #5b6b8a;
  line-height: 1.5;
  margin: 0;
  overflow-wrap: break-word;
}

.bento-card__arrow {
  align-self: flex-end;
  color: #9db0d0;
  opacity: 0.7;
  margin-top: 8px;
  transition: transform 200ms ease, opacity 200ms ease, color 200ms ease;
}

/* ──────────────────────────────────────────────
   01: РН-CARD (Retinopathy Feature Block with Photo)
────────────────────────────────────────────── */
.bento-card--rn {
  background: var(--c-ink);
  color: var(--c-white);
  border-radius: 24px;
  padding: 0;
  overflow: hidden;
  position: relative;
  box-shadow: 0 12px 36px rgba(11, 42, 107, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.1);
  min-height: 100%;
  container-type: inline-size;
  container-name: rn-card;
}

/* Photo Layer — Full Card Background */
.bento-rn-visual {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.bento-rn-picture {
  width: 100%;
  height: 100%;
  display: block;
}

.bento-rn-img {
  width: 100%;
  height: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  object-position: 58% 45%;
  display: block;
}

/* Soft, lightened multi-stop gradient overlay with gentle bottom-left vignette */
.bento-rn-overlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 10% 95%, rgba(11, 42, 107, 0.65) 0%, rgba(11, 42, 107, 0.3) 45%, transparent 75%),
    linear-gradient(90deg,
      rgba(11, 42, 107, 0.85) 0%,
      rgba(11, 42, 107, 0.65) 25%,
      rgba(11, 42, 107, 0.25) 45%,
      rgba(11, 42, 107, 0.05) 65%,
      transparent 100%);
  pointer-events: none;
  z-index: 1;
}

/* Background Pattern */
.bento-card__bg-pattern {
  position: absolute;
  top: -40px;
  left: -40px;
  width: 280px;
  height: 280px;
  pointer-events: none;
  z-index: 1;
  opacity: 0.3;
}

/* Content Container sitting above overlay */
.bento-rn-content {
  position: relative;
  z-index: 2;
  padding: 24px 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 62%;
  max-width: 600px;
  box-sizing: border-box;
  min-height: 100%;
  overflow: visible;
}

.bento-card__rn-header {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 10px;
  margin-bottom: 12px;
}

.bento-badge {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 6px 12px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.01em;
  line-height: 1.3;
  background: rgba(11, 42, 107, 0.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.35);
  width: fit-content;
  white-space: nowrap;
  overflow-wrap: normal;
  word-break: normal;
  hyphens: none;
  text-shadow: 0 1px 3px rgba(11, 42, 107, 0.5);
}

.bento-badge::before {
  content: "";
  display: inline-block;
  width: 2px;
  align-self: stretch;
  height: auto;
  margin-block: -2px;
  border-radius: 1px;
  background-color: rgba(255, 255, 255, 0.85);
  margin-right: 8px;
  flex: none;
  flex-shrink: 0;
}

.bento-num--rn {
  position: absolute;
  top: 16px;
  right: 20px;
  z-index: 3;
  color: rgba(255, 255, 255, 0.5);
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
