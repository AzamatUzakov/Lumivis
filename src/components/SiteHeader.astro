---
// SiteHeader v2 — warm, clean, refined
---

<header id="site-header" class="site-header">
  <div class="container header-inner">
    <a href="/" class="header-logo" aria-label="Lumivis — главная">
      <img src="/header-logo.png" alt="Lumivis" width="120" height="44" />
    </a>

    <nav class="header-nav" aria-label="Основная навигация">
      <a href="#doctors"     class="header-nav__link" data-i18n="nav.doctors">Врачи</a>
      <a href="#equipment"   class="header-nav__link" data-i18n="nav.equipment">Оборудование</a>
      <a href="#services"    class="header-nav__link" data-i18n="nav.services">Услуги</a>
      <a href="#retinopathy" class="header-nav__link" data-i18n="nav.retinopathy">РН-скрининг</a>
      <a href="#reviews"     class="header-nav__link" data-i18n="nav.reviews">Отзывы</a>
      <a href="#contacts"    class="header-nav__link" data-i18n="nav.contacts">Контакты</a>
    </nav>

    <div class="header-right">
      <div class="lang-switcher" role="group" aria-label="Язык">
        <button class="lang-btn lang-btn--active" data-lang="ru" aria-pressed="true">RU</button>
        <button class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
        <button class="lang-btn" data-lang="uz" aria-pressed="false">UZ</button>
      </div>
      <a href="tel:+998995981010" class="header-phone">+998 99 598 10 10</a>
      <a href="#contacts" class="btn btn--primary header-cta" data-i18n="header.cta">Записаться</a>
    </div>

    <button id="burger-btn" class="burger-btn" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Меню">
  <div class="mobile-menu__inner">
    <nav class="mobile-menu__nav">
      <a href="#doctors"     class="mobile-menu__link" data-i18n="nav.doctors">Врачи</a>
      <a href="#equipment"   class="mobile-menu__link" data-i18n="nav.equipment">Оборудование</a>
      <a href="#services"    class="mobile-menu__link" data-i18n="nav.services">Услуги</a>
      <a href="#retinopathy" class="mobile-menu__link" data-i18n="nav.retinopathy">РН-скрининг</a>
      <a href="#reviews"     class="mobile-menu__link" data-i18n="nav.reviews">Отзывы</a>
      <a href="#contacts"    class="mobile-menu__link" data-i18n="nav.contacts">Контакты</a>
    </nav>
    <div class="mobile-menu__meta">
      <a href="tel:+998995981010" class="mobile-menu__phone">+998 99 598 10 10</a>
      <p class="mobile-menu__hours" data-i18n="header.hours">Пн–Сб 09:00–17:00</p>
    </div>
    <div class="lang-switcher lang-switcher--mobile" role="group">
      <button class="lang-btn lang-btn--active" data-lang="ru" aria-pressed="true">RU</button>
      <button class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
      <button class="lang-btn" data-lang="uz" aria-pressed="false">UZ</button>
    </div>
    <a href="#contacts" class="btn btn--primary mobile-menu__cta" data-i18n="header.cta">Записаться</a>
  </div>
</div>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(250, 250, 249, 0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--c-border-lt);
  transition: box-shadow var(--t-base), border-color var(--t-base);
}

.header--scrolled {
  box-shadow: 0 1px 16px rgba(22, 32, 46, 0.08);
  border-bottom-color: var(--c-border);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: var(--s-6);
  height: 66px;
}

.header-logo img {
  height: 38px;
  width: auto;
  object-fit: contain;
}

/* Desktop Nav */
.header-nav {
  display: none;
  align-items: center;
  gap: var(--s-5);
  flex: 1;
  justify-content: center;
}

.header-nav__link {
  font-size: 0.85rem;
  font-weight: 400;
  color: var(--c-body);
  padding-block: var(--s-1);
  position: relative;
  transition: color var(--t-fast);
}

.header-nav__link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 1.5px;
  background: var(--c-amber);
  transform: scaleX(0);
  transition: transform var(--t-base);
  transform-origin: left;
}

.header-nav__link:hover {
  color: var(--c-navy);
}

.header-nav__link:hover::after {
  transform: scaleX(1);
}

/* Right */
.header-right {
  display: none;
  align-items: center;
  gap: var(--s-4);
  margin-left: auto;
}

.header-phone {
  font-size: 0.825rem;
  font-weight: 500;
  color: var(--c-body);
  white-space: nowrap;
  transition: color var(--t-fast);
}

.header-phone:hover { color: var(--c-navy); }

.header-cta {
  padding: 0.55rem 1.25rem;
  font-size: 0.85rem;
}

/* Lang switcher */
.lang-switcher {
  display: flex;
  gap: 1px;
  background: var(--c-border-lt);
  border: 1px solid var(--c-border);
  border-radius: var(--r-sm);
  overflow: hidden;
  padding: 2px;
}

.lang-btn {
  padding: 0.22rem 0.55rem;
  border: none;
  background: transparent;
  font-size: 0.72rem;
  font-weight: 600;
  font-family: var(--font-body);
  color: var(--c-muted);
  cursor: pointer;
  letter-spacing: 0.04em;
  border-radius: 2px;
  transition: all var(--t-fast);
}

.lang-btn--active {
  background: var(--c-white);
  color: var(--c-navy);
  box-shadow: var(--shadow-sm);
}

.lang-btn:hover:not(.lang-btn--active) {
  color: var(--c-text);
}

/* Burger */
.burger-btn {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--s-2);
  margin-left: auto;
  border-radius: var(--r-sm);
}

.burger-line {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--c-navy);
  border-radius: var(--r-full);
  transition: all var(--t-base);
}

/* Mobile menu */
.mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: var(--c-bg);
  transform: translateX(100%);
  transition: transform var(--t-slow);
  overflow-y: auto;
}

.mobile-menu--open { transform: translateX(0); }

.mobile-menu__inner {
  display: flex;
  flex-direction: column;
  padding: 90px var(--pad-x) var(--s-8);
  min-height: 100%;
  gap: var(--s-6);
}

.mobile-menu__nav { display: flex; flex-direction: column; }

.mobile-menu__link {
  font-family: var(--font-display);
  font-size: 1.75rem;
  color: var(--c-navy);
  padding: var(--s-3) 0;
  border-bottom: 1px solid var(--c-border-lt);
  transition: color var(--t-fast), padding-left var(--t-fast);
}

.mobile-menu__link:hover {
  color: var(--c-amber);
  padding-left: var(--s-2);
}

.mobile-menu__meta { display: flex; flex-direction: column; gap: var(--s-2); margin-top: auto; }

.mobile-menu__phone {
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--c-navy);
}

.mobile-menu__hours { font-size: 0.85rem; color: var(--c-muted); }

.lang-switcher--mobile { align-self: flex-start; }

.mobile-menu__cta { align-self: stretch; text-align: center; padding: 0.9rem 1.5rem; }

@media (min-width: 1024px) {
  .header-nav  { display: flex; }
  .header-right { display: flex; }
  .burger-btn  { display: none; }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .header-right { display: flex; }
  .header-phone { display: none; }
}
</style>
