---
// SiteHeader — sticky, responsive, SSG RU/EN/UZ switcher
import { Image } from "astro:assets";
import logoImg from "../assets/logo.png";
import type { Lang } from "../i18n/translations";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
---

<header id="site-header" class="site-header">
  <div class="container header-inner">
    <!-- Logo -->
    <a href={`/${lang}/`} class="header-logo" aria-label="Lumivis — главная">
      <Image src={logoImg} alt="Lumivis" width={300} height={100} loading="eager" format="webp" />
    </a>

    <!-- Desktop Nav -->
    <nav class="header-nav" aria-label="Основная навигация">
      <a href="#doctors" class="header-nav__link">{t("nav.doctors")}</a>
      <a href="#equipment" class="header-nav__link">{t("nav.equipment")}</a>
      <a href="#services" class="header-nav__link">{t("nav.services")}</a>
      <a href="#retinopathy" class="header-nav__link">{t("nav.retinopathy")}</a>
      <a href="#results" class="header-nav__link">{t("nav.videos")}</a>
      <a href="#contacts" class="header-nav__link">{t("nav.contacts")}</a>
    </nav>

    <!-- Desktop Right -->
    <div class="header-right">
      <div class="lang-switcher" role="group" aria-label="Выбор языка">
        <a href="/ru/" class={`lang-btn ${lang === 'ru' ? 'lang-btn--active' : ''}`} data-lang-btn="ru">RU</a>
        <a href="/en/" class={`lang-btn ${lang === 'en' ? 'lang-btn--active' : ''}`} data-lang-btn="en">EN</a>
        <a href="/uz/" class={`lang-btn ${lang === 'uz' ? 'lang-btn--active' : ''}`} data-lang-btn="uz">UZ</a>
      </div>
      <span class="header-hours">{t("header.hours")}</span>
      <a href="#booking-form-section" class="btn btn--primary header-cta">{t("header.cta")}</a>
    </div>

    <!-- Burger -->
    <button
      id="burger-btn"
      class="burger-btn"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-label="Мобильное меню">
  <div class="mobile-menu__inner">
    <div class="mobile-menu__top">
      <div class="lang-switcher lang-switcher--mobile" role="group" aria-label="Выбор языка">
        <a href="/ru/" class={`lang-btn ${lang === 'ru' ? 'lang-btn--active' : ''}`} data-lang-btn="ru">RU</a>
        <a href="/en/" class={`lang-btn ${lang === 'en' ? 'lang-btn--active' : ''}`} data-lang-btn="en">EN</a>
        <a href="/uz/" class={`lang-btn ${lang === 'uz' ? 'lang-btn--active' : ''}`} data-lang-btn="uz">UZ</a>
      </div>

      <div class="mobile-menu__hours-badge">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{t("header.hours")}</span>
      </div>
    </div>

    <nav class="mobile-menu__nav" aria-label="Мобильная навигация">
      <a href="#doctors" class="mobile-menu__link">{t("nav.doctors")}</a>
      <a href="#equipment" class="mobile-menu__link">{t("nav.equipment")}</a>
      <a href="#services" class="mobile-menu__link">{t("nav.services")}</a>
      <a href="#retinopathy" class="mobile-menu__link">{t("nav.retinopathy")}</a>
      <a href="#results" class="mobile-menu__link">{t("nav.videos")}</a>
      <a href="#contacts" class="mobile-menu__link">{t("nav.contacts")}</a>
    </nav>

    <div class="mobile-menu__meta">
      <a href="tel:+998995981010" class="mobile-menu__phone">+998 99 598 10 10</a>
    </div>

    <a href="#booking-form-section" class="btn btn--primary mobile-menu__cta">{t("header.cta")}</a>
  </div>
</div>

<style>
/* ── Header ── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--c-border);
  transition: box-shadow var(--t-base);
}

.header--scrolled {
  box-shadow: var(--shadow-header);
}

.header-inner {
  display: flex;
  align-items: center;
  gap: var(--s-6);
  height: 72px;
}

/* Logo */
.header-logo {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-decoration: none;
  line-height: 1;
}

.header-logo img {
  height: 42px;
  width: auto;
  object-fit: contain;
  mix-blend-mode: multiply;
  display: block;
}

/* Desktop Nav */
.header-nav {
  display: none;
  align-items: center;
  gap: var(--s-5);
  flex: 1;
  justify-content: center;
}

.header-nav__link {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--c-text);
  position: relative;
  padding-block: var(--s-1);
  transition: color var(--t-fast);
  white-space: nowrap;
}

.header-nav__link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--c-sky);
  border-radius: var(--r-full);
  transition: width var(--t-base);
}

.header-nav__link:hover {
  color: var(--c-sky);
}

.header-nav__link:hover::after {
  width: 100%;
}

/* Right section */
.header-right {
  display: none;
  align-items: center;
  gap: var(--s-4);
  margin-left: auto;
}

.header-hours {
  font-size: 0.8rem;
  color: var(--c-muted);
  white-space: nowrap;
}

.header-cta {
  padding: 0.55rem 1.25rem;
  font-size: 0.875rem;
}

/* Lang Switcher */
.lang-switcher {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--c-surface);
  border-radius: var(--r-full);
  padding: 3px;
}

.lang-btn {
  padding: 0.25rem 0.6rem;
  border-radius: var(--r-full);
  border: none;
  background: transparent;
  font-size: 0.75rem;
  font-weight: 600;
  font-family: var(--font-body);
  color: var(--c-muted);
  cursor: pointer;
  transition: all var(--t-fast);
  letter-spacing: 0.03em;
  text-decoration: none;
  display: inline-block;
}

.lang-btn--active {
  background: var(--c-white);
  color: var(--c-sky);
  box-shadow: 0 1px 4px rgba(11,42,107,0.12);
}

.lang-btn:hover:not(.lang-btn--active) {
  color: var(--c-ink);
}

/* Burger */
.burger-btn {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--s-2);
  margin-left: auto;
  border-radius: var(--r-sm);
  transition: background var(--t-fast);
}

.burger-btn:hover {
  background: var(--c-surface);
}

.burger-line {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--c-ink);
  border-radius: var(--r-full);
  transition: all var(--t-base);
}

/* Mobile Menu */
.mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: var(--c-white);
  transform: translateX(100%);
  transition: transform var(--t-slow), visibility var(--t-slow);
  overflow-y: auto;
  visibility: hidden;
  pointer-events: none;
}

.mobile-menu--open {
  transform: translateX(0);
  visibility: visible;
  pointer-events: auto;
}

.mobile-menu__inner {
  display: flex;
  flex-direction: column;
  padding: 90px var(--pad-x) var(--s-8);
  min-height: 100%;
  gap: var(--s-6);
}

.mobile-menu__nav {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.mobile-menu__link {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--c-ink);
  padding: var(--s-2) 0;
  border-bottom: 1px solid var(--c-border);
  transition: color var(--t-fast), padding-left var(--t-fast);
}

.mobile-menu__link:hover {
  color: var(--c-sky);
  padding-left: var(--s-3);
}

.mobile-menu__meta {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-top: auto;
}

.mobile-menu__top {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--s-3);
}

.mobile-menu__hours-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.75rem;
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--r-full);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--c-muted);
  line-height: 1.2;
}

.mobile-menu__hours-badge svg {
  color: var(--c-sky);
  flex-shrink: 0;
}

.mobile-menu__phone {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--c-ink);
}

.lang-switcher--mobile {
  align-self: flex-start;
  padding: 4px;
}

.lang-switcher--mobile .lang-btn {
  font-size: 0.875rem;
  padding: 0.35rem 0.8rem;
}

.mobile-menu__cta {
  align-self: stretch;
  padding: 0.9rem 1.5rem;
  text-align: center;
  font-size: 1rem;
}

/* Responsive */
@media (min-width: 1024px) {
  .header-logo { transform: translateY(-4px); }
  .header-nav { display: flex; }
  .header-right { display: flex; }
  .burger-btn { display: none; }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .header-right {
    display: flex;
    gap: var(--s-3);
  }
  .header-hours { display: none; }
}
</style>
