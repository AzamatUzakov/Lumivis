---
// HeroSection v2 — editorial, clean, warm
---

<section class="hero" id="hero">
  <div class="container hero__inner">

    <!-- LEFT: Text -->
    <div class="hero__content">
      <p class="eyebrow eyebrow--amber hero__eyebrow">
        Самарканд · Офтальмологическая клиника
      </p>

      <h1 class="hero__h1" data-i18n="hero.h1">
        Первый взгляд<br>в жизни —<br>под нашим<br>наблюдением
      </h1>

      <p class="hero__subtitle" data-i18n="hero.subtitle">
        Полный цикл офтальмологической помощи взрослым и детям: диагностика,
        аппаратное и хирургическое лечение косоглазия, ретинопатии и нарушений зрения.
      </p>

      <div class="hero__actions">
        <a href="#contacts" class="btn btn--primary" data-i18n="hero.cta1">
          Записаться на приём
        </a>
        <a href="#services" class="btn btn--outline" data-i18n="hero.cta2">
          Наши услуги
        </a>
      </div>

      <!-- Stats — горизонтально, чисто -->
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-val" data-i18n="hero.stat1.value">10+</span>
          <span class="hero__stat-label" data-i18n="hero.stat1.label">лет опыта</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-val" data-i18n="hero.stat2.value">3 000+</span>
          <span class="hero__stat-label" data-i18n="hero.stat2.label">пациентов в год</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-val" data-i18n="hero.stat3.value">8</span>
          <span class="hero__stat-label" data-i18n="hero.stat3.label">аппаратов</span>
        </div>
      </div>
    </div>

    <!-- RIGHT: Photo -->
    <div class="hero__visual">
      <div class="hero__photo-wrap">
        <img
          src="/hero-doctor.png"
          alt="Врач-офтальмолог Lumivis"
          data-i18n-alt="hero.img.alt"
          class="hero__photo"
          width="480"
          height="560"
          fetchpriority="high"
        />
        <!-- Маленький floating badge — единственный декоративный элемент -->
        <div class="hero__badge-float">
          <span class="hero__badge-dot" aria-hidden="true"></span>
          Единственная в Самарканде клиника РН-скрининга
        </div>
      </div>
    </div>

  </div>

  <!-- Тонкая нижняя полоса янтаря — сигнатурный элемент -->
  <div class="hero__amber-line" aria-hidden="true"></div>
</section>

<style>
.hero {
  background: var(--c-bg);
  padding-block: clamp(3.5rem, 8vw, 6rem);
  position: relative;
  overflow: hidden;
}

/* Очень тихий фоновый паттерн — почти невидимый */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 80% 20%, rgba(29, 84, 196, 0.03) 0%, transparent 60%),
    radial-gradient(circle at 20% 80%, rgba(11, 32, 69, 0.03) 0%, transparent 60%);
  pointer-events: none;
}

.hero__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-12);
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Content */
.hero__eyebrow {
  display: block;
  margin-bottom: var(--s-5);
}

.hero__h1 {
  font-size: clamp(2.4rem, 5.5vw, 4rem);
  line-height: 1.05;
  letter-spacing: -0.02em;
  margin-bottom: var(--s-6);
  color: var(--c-navy);
}

.hero__subtitle {
  font-size: clamp(0.9rem, 1.4vw, 1.05rem);
  color: var(--c-body);
  line-height: 1.75;
  max-width: 46ch;
  margin-bottom: var(--s-8);
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-3);
  margin-bottom: var(--s-10);
}

/* Stats */
.hero__stats {
  display: flex;
  gap: var(--s-8);
  flex-wrap: wrap;
  padding-top: var(--s-6);
  border-top: 1px solid var(--c-border-lt);
}

.hero__stat {
  display: flex;
  flex-direction: column;
  gap: var(--s-1);
}

.hero__stat-val {
  font-family: var(--font-display);
  font-size: 2rem;
  line-height: 1;
  color: var(--c-navy);
  letter-spacing: -0.02em;
}

.hero__stat-label {
  font-size: 0.78rem;
  color: var(--c-muted);
  font-weight: 400;
}

/* Visual */
.hero__visual {
  display: flex;
  justify-content: center;
}

.hero__photo-wrap {
  position: relative;
  max-width: 440px;
  width: 100%;
}

.hero__photo {
  width: 100%;
  height: auto;
  border-radius: var(--r-lg);
  object-fit: cover;
  /* Очень тонкое обрамление — не тень-ореол а деликатная граница */
  box-shadow:
    0 0 0 1px var(--c-border),
    0 24px 64px rgba(11, 32, 69, 0.12);
}

/* Floating badge — маленький, скромный */
.hero__badge-float {
  position: absolute;
  bottom: 20px;
  left: -16px;
  background: var(--c-white);
  border: 1px solid var(--c-border);
  border-left: 3px solid var(--c-amber);
  border-radius: var(--r-md);
  padding: 0.6rem 0.9rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--c-text);
  box-shadow: var(--shadow-card);
  max-width: 200px;
  line-height: 1.4;
  display: flex;
  align-items: flex-start;
  gap: var(--s-2);
}

.hero__badge-dot {
  width: 7px;
  height: 7px;
  background: var(--c-amber);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
}

/* Янтарная полоска внизу секции */
.hero__amber-line {
  height: 3px;
  background: linear-gradient(90deg, transparent 0%, var(--c-amber) 30%, var(--c-amber) 70%, transparent 100%);
  opacity: 0.35;
  margin-top: clamp(3rem, 6vw, 5rem);
}

/* Responsive */
@media (min-width: 900px) {
  .hero__inner {
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--s-16);
  }
}
</style>
