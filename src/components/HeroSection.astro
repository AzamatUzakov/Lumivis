---
// HeroSection — main hero block
---

<section class="hero" id="hero">
  <!-- Background diaphragm SVG -->
  <div class="hero__bg-pattern" aria-hidden="true">
    <svg viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="400" cy="400" r="80" stroke="#2E86F5" stroke-width="1" opacity="0.08"/>
      <circle cx="400" cy="400" r="150" stroke="#2E86F5" stroke-width="1" opacity="0.07"/>
      <circle cx="400" cy="400" r="230" stroke="#2E86F5" stroke-width="1" opacity="0.055"/>
      <circle cx="400" cy="400" r="320" stroke="#2E86F5" stroke-width="1" opacity="0.04"/>
      <circle cx="400" cy="400" r="420" stroke="#2E86F5" stroke-width="0.8" opacity="0.03"/>
      <!-- Diaphragm blades -->
      <line x1="400" y1="0" x2="400" y2="800" stroke="#2E86F5" stroke-width="0.6" opacity="0.04"/>
      <line x1="0" y1="400" x2="800" y2="400" stroke="#2E86F5" stroke-width="0.6" opacity="0.04"/>
      <line x1="96" y1="96" x2="704" y2="704" stroke="#2E86F5" stroke-width="0.6" opacity="0.035"/>
      <line x1="704" y1="96" x2="96" y2="704" stroke="#2E86F5" stroke-width="0.6" opacity="0.035"/>
      <line x1="0" y1="200" x2="800" y2="600" stroke="#2E86F5" stroke-width="0.5" opacity="0.025"/>
      <line x1="800" y1="200" x2="0" y2="600" stroke="#2E86F5" stroke-width="0.5" opacity="0.025"/>
      <line x1="200" y1="0" x2="600" y2="800" stroke="#2E86F5" stroke-width="0.5" opacity="0.025"/>
      <line x1="600" y1="0" x2="200" y2="800" stroke="#2E86F5" stroke-width="0.5" opacity="0.025"/>
      <!-- Centre dot -->
      <circle cx="400" cy="400" r="8" fill="#2E86F5" opacity="0.08"/>
    </svg>
  </div>

  <div class="container hero__inner">
    <!-- Left: Text content -->
    <div class="hero__content">
      <div class="badge badge--blue hero__badge" data-i18n="hero.badge">
        Самарканд · Офтальмологическая клиника
      </div>

      <h1 class="hero__h1" data-i18n="hero.h1">
        Первый взгляд в жизни — под нашим наблюдением
      </h1>

      <p class="hero__subtitle" data-i18n="hero.subtitle">
        Полный цикл офтальмологической помощи взрослым и детям: диагностика,
        аппаратное и хирургическое лечение косоглазия, ретинопатии и нарушений зрения.
      </p>

      <div class="hero__actions">
        <a href="#contacts" class="btn btn--primary" data-i18n="hero.cta1">
          Записаться на приём
        </a>
        <a href="#services" class="btn btn--outline" data-i18n="hero.cta2">
          Наши услуги
        </a>
      </div>

      <!-- Stats -->
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value" data-i18n="hero.stat1.value">10+</span>
          <span class="hero__stat-label" data-i18n="hero.stat1.label">лет опыта</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat">
          <span class="hero__stat-value" data-i18n="hero.stat2.value">3 000+</span>
          <span class="hero__stat-label" data-i18n="hero.stat2.label">пациентов в год</span>
        </div>
        <div class="hero__stat-divider" aria-hidden="true"></div>
        <div class="hero__stat">
          <span class="hero__stat-value" data-i18n="hero.stat3.value">8</span>
          <span class="hero__stat-label" data-i18n="hero.stat3.label">аппаратов</span>
        </div>
      </div>
    </div>

    <!-- Right: Doctor image -->
    <div class="hero__visual">
      <!-- Decorative iris ring -->
      <div class="hero__iris-ring" aria-hidden="true">
        <svg viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="210" cy="210" r="200" stroke="#2E86F5" stroke-width="1.5" stroke-dasharray="8 6" opacity="0.3"/>
          <circle cx="210" cy="210" r="185" stroke="#5AA4F8" stroke-width="0.8" opacity="0.2"/>
          <!-- Small ticks -->
          <circle cx="210" cy="12" r="4" fill="#2E86F5" opacity="0.4"/>
          <circle cx="210" cy="408" r="4" fill="#2E86F5" opacity="0.4"/>
          <circle cx="12" cy="210" r="4" fill="#2E86F5" opacity="0.4"/>
          <circle cx="408" cy="210" r="4" fill="#2E86F5" opacity="0.4"/>
          <circle cx="62" cy="62" r="3" fill="#2E86F5" opacity="0.3"/>
          <circle cx="358" cy="62" r="3" fill="#2E86F5" opacity="0.3"/>
          <circle cx="62" cy="358" r="3" fill="#2E86F5" opacity="0.3"/>
          <circle cx="358" cy="358" r="3" fill="#2E86F5" opacity="0.3"/>
        </svg>
      </div>

      <div class="hero__img-wrap">
        <div class="hero__img-backdrop" aria-hidden="true"></div>
        <img
          src="/hero-doctor.png"
          alt="Врач-офтальмолог Lumivis"
          data-i18n-alt="hero.img.alt"
          class="hero__img"
          width="440"
          height="520"
        />
        <!-- Floating badge: Doctor Name -->
        <div class="hero__float-badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2E86F5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span data-i18n="hero.doctor.badge">Фаридун Саидакбарович</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  background: linear-gradient(135deg, #ffffff 0%, #f0f6ff 60%, #e5f0ff 100%);
  overflow: hidden;
  padding-block: clamp(3rem, 8vw, 5.5rem);
}

.hero__bg-pattern {
  position: absolute;
  right: -10%;
  top: 50%;
  transform: translateY(-50%);
  width: 700px;
  height: 700px;
  pointer-events: none;
  opacity: 0.8;
}

.hero__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-12);
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Content */
.hero__badge {
  margin-bottom: var(--s-5);
}

.hero__h1 {
  font-size: clamp(2rem, 5vw, 3.2rem);
  line-height: 1.15;
  margin-bottom: var(--s-5);
  color: var(--c-ink);
  max-width: 100%;
}

.hero__subtitle {
  font-size: clamp(0.95rem, 1.5vw, 1.1rem);
  color: var(--c-muted);
  line-height: 1.7;
  max-width: 48ch;
  margin-bottom: var(--s-8);
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-3);
  margin-bottom: var(--s-10);
}

/* Stats */
.hero__stats {
  display: flex;
  align-items: center;
  gap: var(--s-5);
  flex-wrap: wrap;
}

.hero__stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero__stat-value {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--c-ink);
  line-height: 1;
}

.hero__stat-label {
  font-size: 0.78rem;
  color: var(--c-muted);
  font-weight: 500;
}

.hero__stat-divider {
  width: 1px;
  height: 36px;
  background: var(--c-border);
  flex-shrink: 0;
}

/* Visual */
.hero__visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero__iris-ring {
  position: absolute;
  width: 420px;
  height: 420px;
  pointer-events: none;
  animation: iris-rotate 30s linear infinite;
}

@keyframes iris-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .hero__iris-ring { animation: none; }
}

.hero__img-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.hero__img-backdrop {
  position: absolute;
  bottom: 0;
  width: 90%;
  max-width: 340px;
  height: 88%;
  background: linear-gradient(180deg, #ffffff 0%, #e0edff 100%);
  border: 1px solid rgba(46, 134, 245, 0.2);
  border-radius: 180px 180px 32px 32px;
  box-shadow: 0 20px 50px rgba(11, 42, 107, 0.08), inset 0 2px 10px rgba(255, 255, 255, 0.9);
  z-index: 0;
}

.hero__img {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 380px;
  height: auto;
  display: block;
  filter: drop-shadow(0 15px 35px rgba(11, 42, 107, 0.14));
  /* Smooth mask-image gradient fade to remove bottom cut completely */
  -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 68%, rgba(0, 0, 0, 0) 97%);
  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 68%, rgba(0, 0, 0, 0) 97%);
}

.hero__float-badge {
  position: absolute;
  bottom: 30px;
  left: -15px;
  z-index: 2;
  background: var(--c-white);
  border: 1px solid var(--c-border);
  border-radius: var(--r-full);
  padding: 0.55rem 1.1rem;
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--c-ink);
  box-shadow: var(--shadow-card);
  white-space: nowrap;
}

/* Responsive */
@media (max-width: 600px) {
  .hero__h1 {
    max-width: 100%;
    font-size: clamp(1.65rem, 6.5vw, 2.2rem);
  }

  .hero__subtitle {
    max-width: 100%;
  }

  .hero__iris-ring {
    width: 320px;
    height: 320px;
    max-width: 85vw;
    max-height: 85vw;
  }

  .hero__float-badge {
    left: 0;
    bottom: 10px;
  }

  .hero__actions {
    flex-direction: column;
    width: 100%;
  }

  .hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
}

@media (min-width: 900px) {
  .hero__h1 {
    max-width: 14ch;
  }

  .hero__inner {
    grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
  }

  .hero__bg-pattern {
    width: 800px;
    height: 800px;
  }
}

@media (min-width: 1100px) {
  .hero__inner {
    grid-template-columns: 55fr 45fr;
  }
}
</style>
