---
// ProstheticsSection.astro — Ocular Prosthetics Before/After cases
// Native overflow-x scroll container with scroll-snap and JS auto-scroll ticker.
import { Image } from "astro:assets";

/* =========================================================================
   ПОДСТАНОВКА РЕАЛЬНЫХ ФОТО В БУДУЩЕМ:
   1. Добавьте файлы фото в папку src/assets/prosthetics/ (например: case1_before.jpg, case1_after.jpg)
   2. Заимпортируйте их здесь:
      import case1Before from "../assets/prosthetics/case1_before.jpg";
      import case1After from "../assets/prosthetics/case1_after.jpg";
   3. Укажите в нужном объекте:
      beforeImg: case1Before,
      afterImg: case1After,
   Разметка автоматически отобразит <Image /> вместо серых плейсхолдеров!
   ========================================================================= */

interface ProstheticCase {
  id: number;
  titleRu: string;
  descRu: string;
  beforeImg?: ImageMetadata | null;
  afterImg?: ImageMetadata | null;
}

const cases: ProstheticCase[] = [
  {
    id: 1,
    titleRu: "Кейс 01 — Субатрофия глазного яблока",
    descRu: "Индивидуальный тонкостенный протез с точным повторением рисунка радужки здорового глаза",
    beforeImg: null,
    afterImg: null,
  },
  {
    id: 2,
    titleRu: "Кейс 02 — Посттравматический анофтальм",
    descRu: "Восстановление симметрии глазной щели и естественного объёма конъюнктивальной полости",
    beforeImg: null,
    afterImg: null,
  },
  {
    id: 3,
    titleRu: "Кейс 03 — Врождённая микрофтальмия",
    descRu: "Ступенчатое протезирование для стимуляции роста орбиты у ребенка",
    beforeImg: null,
    afterImg: null,
  },
  {
    id: 4,
    titleRu: "Кейс 04 — Коррекция формы и посадки",
    descRu: "Изготовление сложного слоистого протеза с высокой подвижностью",
    beforeImg: null,
    afterImg: null,
  },
  {
    id: 5,
    titleRu: "Кейс 05 — Подбор цвета и склеры",
    descRu: "Ручная роспись радужки с имитацией сосудистого рисунка склеры",
    beforeImg: null,
    afterImg: null,
  },
  {
    id: 6,
    titleRu: "Кейс 06 — Косметическая реабилитация",
    descRu: "Полное возвращение уверенности и эстетической гармонии взгляда",
    beforeImg: null,
    afterImg: null,
  },
];

// Duplicate cases 3 times so manual and auto scroll have seamless infinite content
const displayCases = [...cases, ...cases, ...cases];
---

<section class="prosthetics section section--surface" id="prosthetics" aria-labelledby="prosthetics-title">
  <div class="container">
    <div class="section-header reveal">
      <h2 id="prosthetics-title" data-i18n="prosthetics.title">Результаты глазного протезирования</h2>
      <p data-i18n="prosthetics.subtitle">До и после индивидуального изготовления и подбора глазного протеза по форме и цвету</p>
    </div>
  </div>

  <!-- Native overflow-x scroll container with scroll-snap & drag-to-scroll -->
  <div class="prosthetics__slider-wrapper" aria-label="Карусель результатов протезирования">
    <div class="prosthetics__slider" id="prosthetics-slider" data-snap="false">
      {displayCases.map((item, index) => (
        <article class="prosthetics-card" aria-label={`${item.titleRu}`}>
          <div class="prosthetics-card__header">
            <h3 class="prosthetics-card__title" data-i18n={`prosthetics.case${item.id}.title`}>
              {item.titleRu}
            </h3>
          </div>

          <!-- Before / After Visual Pair -->
          <div class="prosthetics-card__comparison">
            <!-- BEFORE BLOCK -->
            <div class="prosthetics-media prosthetics-media--before">
              <span class="prosthetics-media__badge" data-i18n="prosthetics.before">ДО</span>
              <div class="prosthetics-media__frame">
                {item.beforeImg ? (
                  <Image
                    src={item.beforeImg}
                    alt={`Фото до — ${item.titleRu}`}
                    class="prosthetics-media__img"
                    width={400}
                    height={300}
                    format="webp"
                    quality={80}
                  />
                ) : (
                  <div class="prosthetics-placeholder">
                    <svg class="prosthetics-placeholder__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <span class="prosthetics-placeholder__text" data-i18n="prosthetics.placeholder.before">Фото до протезирования</span>
                  </div>
                )}
              </div>
            </div>

            <!-- AFTER BLOCK -->
            <div class="prosthetics-media prosthetics-media--after">
              <span class="prosthetics-media__badge" data-i18n="prosthetics.after">ПОСЛЕ</span>
              <div class="prosthetics-media__frame">
                {item.afterImg ? (
                  <Image
                    src={item.afterImg}
                    alt={`Фото после — ${item.titleRu}`}
                    class="prosthetics-media__img"
                    width={400}
                    height={300}
                    format="webp"
                    quality={80}
                  />
                ) : (
                  <div class="prosthetics-placeholder">
                    <svg class="prosthetics-placeholder__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <span class="prosthetics-placeholder__text" data-i18n="prosthetics.placeholder.after">Фото после протезирования</span>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Bottom Description -->
          <div class="prosthetics-card__footer">
            <p class="prosthetics-card__desc" data-i18n={`prosthetics.case${item.id}.desc`}>
              {item.descRu}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
/* ── Section Wrapper ── */
:global(.prosthetics) {
  padding-block: clamp(3.5rem, 7vw, 5.5rem);
  background: var(--c-surface);
  overflow: hidden;
  position: relative;
}

/* ── Outer Wrapper with gradient mask ── */
:global(.prosthetics__slider-wrapper) {
  width: 100%;
  position: relative;
  mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
}

/* ── Native Scroll Container — continuous ticker mode (no snap during auto-scroll) ── */
:global(.prosthetics__slider) {
  display: flex !important;
  gap: 20px !important;
  overflow-x: auto !important;
  scroll-snap-type: none;
  overscroll-behavior-x: contain !important;
  scrollbar-width: none !important;
  -webkit-overflow-scrolling: touch !important;
  padding-inline: var(--pad-x, clamp(1rem, 4vw, 2rem)) !important;
  scroll-padding-inline: var(--pad-x, clamp(1rem, 4vw, 2rem)) !important;
  padding-block: 10px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  cursor: grab;
}

/* Enable proximity snap only when user actively touches / interacts */
:global(.prosthetics__slider[data-snap="true"]) {
  scroll-snap-type: x proximity !important;
}

:global(.prosthetics__slider::-webkit-scrollbar) {
  display: none !important;
}

:global(.prosthetics__slider:active) {
  cursor: grabbing;
}

/* ── Card Styling ── */
:global(.prosthetics-card) {
  flex: 0 0 clamp(310px, 30vw, 420px) !important;
  scroll-snap-align: start !important;
  background: #ffffff;
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg, 20px);
  padding: 20px;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16px;
  transition: transform 240ms ease, box-shadow 240ms ease, border-color 240ms ease;
  user-select: none;
}

.prosthetics-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 28px rgba(11, 42, 107, 0.12);
  border-color: rgba(46, 134, 245, 0.35);
}

.prosthetics-card__header {
  border-bottom: 1px solid rgba(11, 42, 107, 0.07);
  padding-bottom: 10px;
}

.prosthetics-card__title {
  font-family: var(--font-display);
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.3;
  margin: 0;
}

/* ── Comparison Grid (Before / After side-by-side) ── */
.prosthetics-card__comparison {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.prosthetics-media {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* Badges — Neutral, refined medical styling */
.prosthetics-media__badge {
  align-self: flex-start;
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 4px 10px;
  border-radius: 6px;
  line-height: 1;
  background: #f0f6ff;
  color: var(--c-ink);
  border: 1px solid rgba(11, 42, 107, 0.12);
}

/* Frame & Placeholders — Unified neutral brand surface */
.prosthetics-media__frame {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 12px;
  overflow: hidden;
  background: #f0f6ff;
  border: 1px solid rgba(11, 42, 107, 0.08);
}

.prosthetics-media__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.prosthetics-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px;
  text-align: center;
  box-sizing: border-box;
  background: linear-gradient(135deg, #f8fafc 0%, #edf4fd 100%);
  color: #5b6b8a;
}

.prosthetics-placeholder__icon {
  color: #2e86f5;
  opacity: 0.75;
}

.prosthetics-placeholder__text {
  font-size: 0.75rem;
  font-weight: 600;
  color: #5b6b8a;
  line-height: 1.25;
}

/* ── Footer text ── */
.prosthetics-card__footer {
  padding-top: 4px;
}

.prosthetics-card__desc {
  font-size: 0.83rem;
  color: var(--c-muted);
  line-height: 1.45;
  margin: 0;
}

/* Mobile Responsiveness */
@media (max-width: 599px) {
  .prosthetics-card {
    flex: 0 0 295px !important;
    padding: 16px;
    gap: 12px;
  }

  .prosthetics__slider {
    gap: 14px !important;
  }
}
</style>

<script>
  function initProstheticsSlider() {
    const slider = document.getElementById('prosthetics-slider') as HTMLElement | null;
    const section = document.getElementById('prosthetics') as HTMLElement | null;
    if (!slider) return;

    let animId: number | null = null;
    let isInteracting = false;
    let isVisibleInViewport = false;
    let resumeTimeout: ReturnType<typeof setTimeout> | null = null;
    const speed = 0.75; // px per frame — smooth continuous marquee speed

    function getSingleSetWidth(): number {
      const firstCard = slider.querySelector('.prosthetics-card') as HTMLElement | null;
      if (!firstCard) return 1980;
      const gap = parseFloat(window.getComputedStyle(slider).gap) || 20;
      return 6 * (firstCard.offsetWidth + gap);
    }

    function tick() {
      if (!slider) return;

      const singleSetWidth = getSingleSetWidth();

      if (!isInteracting && isVisibleInViewport && !document.hidden) {
        slider.dataset.snap = 'false';
        slider.scrollLeft += speed;
      }

      // Seamless loop reset in both scroll directions (forward and backward)
      if (slider.scrollLeft >= singleSetWidth * 2) {
        slider.scrollLeft -= singleSetWidth;
      } else if (slider.scrollLeft <= 5) {
        slider.scrollLeft += singleSetWidth;
      }

      if (isVisibleInViewport && !document.hidden) {
        animId = requestAnimationFrame(tick);
      } else {
        animId = null;
      }
    }

    function startAutoScroll() {
      if (!animId && isVisibleInViewport && !document.hidden) {
        animId = requestAnimationFrame(tick);
      }
    }

    function stopAutoScroll() {
      if (animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    }

    // Debounced activity handler: ONLY called by direct user input events (touch, mouse, wheel)
    function handleUserActivity() {
      isInteracting = true;
      if (slider) slider.dataset.snap = 'true';

      if (resumeTimeout) {
        clearTimeout(resumeTimeout);
      }

      resumeTimeout = setTimeout(() => {
        isInteracting = false;
        if (slider) slider.dataset.snap = 'false';
      }, 2500);
    }

    // Direct user interaction listeners (do NOT attach to 'scroll' to avoid feedback loop from programmatic scrollLeft)
    slider.addEventListener('touchstart', handleUserActivity, { passive: true });
    slider.addEventListener('touchmove', handleUserActivity, { passive: true });
    slider.addEventListener('touchend', handleUserActivity, { passive: true });
    slider.addEventListener('pointerdown', handleUserActivity, { passive: true });
    slider.addEventListener('pointerup', handleUserActivity, { passive: true });
    slider.addEventListener('mousedown', handleUserActivity, { passive: true });
    slider.addEventListener('wheel', handleUserActivity, { passive: true });

    // Desktop Mouse Drag to Scroll (Grab & Drag)
    let isMouseDown = false;
    let startX = 0;
    let scrollLeftStart = 0;

    slider.addEventListener('mousedown', (e) => {
      isMouseDown = true;
      handleUserActivity();
      startX = e.pageX - slider.offsetLeft;
      scrollLeftStart = slider.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (isMouseDown) {
        isMouseDown = false;
        handleUserActivity();
      }
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isMouseDown) return;
      handleUserActivity();
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5;
      slider.scrollLeft = scrollLeftStart - walk;
    });

    // ── Performance Optimization 1: IntersectionObserver ──
    // Stop rAF loop entirely when the section is not visible on screen (0% CPU impact when scrolled away)
    if (section && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisibleInViewport = entry.isIntersecting;
          if (entry.isIntersecting) {
            startAutoScroll();
          } else {
            stopAutoScroll();
          }
        });
      }, { threshold: 0.02 });
      observer.observe(section);
    } else {
      isVisibleInViewport = true;
      startAutoScroll();
    }

    // ── Performance Optimization 2: Page Visibility API ──
    // Pause rAF loop when user switches browser tab or minimizes window
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoScroll();
      } else if (isVisibleInViewport) {
        startAutoScroll();
      }
    });
  }

  // Ensure script runs reliably whether DOMContentLoaded fired or not
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProstheticsSlider);
  } else {
    initProstheticsSlider();
  }
  document.addEventListener('astro:page-load', initProstheticsSlider);
</script>
