---
// ProstheticsSection.astro — Ocular Prosthetics Before/After cases
// Native overflow-x scroll container with scroll-snap and JS auto-scroll ticker.
import { Image } from "astro:assets";
import { useTranslations, type SupportedLang } from "../i18n/utils";

interface Props {
  lang?: SupportedLang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);

import case1Before from "../assets/prosthetics/case1_before.jpg";
import case1After from "../assets/prosthetics/case1_after.jpg";
import case2Before from "../assets/prosthetics/case2_before.jpg";
import case2After from "../assets/prosthetics/case2_after.jpg";
import case3Before from "../assets/prosthetics/case3_before.jpg";
import case3After from "../assets/prosthetics/case3_after.jpg";
import case4Before from "../assets/prosthetics/case4_before.jpg";
import case4After from "../assets/prosthetics/case4_after.jpg";
import case5Before from "../assets/prosthetics/case5_before.jpg";
import case5After from "../assets/prosthetics/case5_after.jpg";
import case6Before from "../assets/prosthetics/case6_before.jpg";
import case6After from "../assets/prosthetics/case6_after.jpg";
import case7Before from "../assets/prosthetics/case7_before.jpg";
import case7After from "../assets/prosthetics/case7_after.jpg";

interface ProstheticCase {
  id: number;
  beforeImg?: ImageMetadata | null;
  afterImg?: ImageMetadata | null;
}

const cases: ProstheticCase[] = [
  { id: 1, beforeImg: case1Before, afterImg: case1After },
  { id: 2, beforeImg: case2Before, afterImg: case2After },
  { id: 3, beforeImg: case3Before, afterImg: case3After },
  { id: 4, beforeImg: case4Before, afterImg: case4After },
  { id: 5, beforeImg: case5Before, afterImg: case5After },
  { id: 6, beforeImg: case6Before, afterImg: case6After },
  { id: 7, beforeImg: case7Before, afterImg: case7After },
];

// Duplicate cases 3 times so manual and auto scroll have seamless infinite content
const displayCases = [...cases, ...cases, ...cases];
---

<section class="prosthetics section section--surface" id="prosthetics" aria-labelledby="prosthetics-title">
  <div class="container">
    <div class="section-header reveal">
      <h2 id="prosthetics-title" data-i18n="prosthetics.title">{t("prosthetics.title")}</h2>
      <p data-i18n="prosthetics.subtitle">{t("prosthetics.subtitle")}</p>
    </div>
  </div>

  <!-- Native overflow-x scroll container with scroll-snap & drag-to-scroll -->
  <div class="prosthetics__slider-wrapper" aria-label={t("prosthetics.title")}>
    <div class="prosthetics__slider" id="prosthetics-slider" data-case-count={cases.length}>
      {displayCases.map((item) => {
        const titleKey = `prosthetics.case${item.id}.title`;
        const descKey = `prosthetics.case${item.id}.desc`;
        const itemTitle = t(titleKey);
        const itemDesc = t(descKey);

        return (
          <article class="prosthetics-card" aria-label={itemTitle}>
            <div class="prosthetics-card__header">
              <h3 class="prosthetics-card__title" data-i18n={titleKey}>
                {itemTitle}
              </h3>
            </div>

            <!-- Before / After Visual Pair -->
            <div class="prosthetics-card__comparison">
              <!-- BEFORE BLOCK -->
              <div class="prosthetics-media prosthetics-media--before">
                <span class="prosthetics-media__badge" data-i18n="prosthetics.before">{t("prosthetics.before")}</span>
                <div class="prosthetics-media__frame">
                  {item.beforeImg ? (
                    <Image
                      src={item.beforeImg}
                      alt={`${t("prosthetics.before")} — ${itemTitle}`}
                      class="prosthetics-media__img"
                      width={400}
                      height={300}
                      format="webp"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="prosthetics-placeholder">
                      <svg class="prosthetics-placeholder__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/>
                        <circle cx="12" cy="12" r="3"/>
                      </svg>
                      <span class="prosthetics-placeholder__text" data-i18n="prosthetics.placeholder.before">{t("prosthetics.placeholder.before")}</span>
                    </div>
                  )}
                </div>
              </div>

              <!-- AFTER BLOCK -->
              <div class="prosthetics-media prosthetics-media--after">
                <span class="prosthetics-media__badge" data-i18n="prosthetics.after">{t("prosthetics.after")}</span>
                <div class="prosthetics-media__frame">
                  {item.afterImg ? (
                    <Image
                      src={item.afterImg}
                      alt={`${t("prosthetics.after")} — ${itemTitle}`}
                      class="prosthetics-media__img"
                      width={400}
                      height={300}
                      format="webp"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="prosthetics-placeholder">
                      <svg class="prosthetics-placeholder__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/>
                        <circle cx="12" cy="12" r="3"/>
                      </svg>
                      <span class="prosthetics-placeholder__text" data-i18n="prosthetics.placeholder.after">{t("prosthetics.placeholder.after")}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>


          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
/* ── Section Wrapper ── */
:global(.prosthetics) {
  padding-block: clamp(3.5rem, 7vw, 5.5rem);
  background: var(--c-surface);
  overflow: hidden;
  position: relative;
}

/* ── Outer Wrapper with gradient mask ── */
:global(.prosthetics__slider-wrapper) {
  width: 100%;
  position: relative;
  mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
}

/* ── Native Scroll Container — continuous ticker mode ── */
:global(.prosthetics__slider) {
  display: flex !important;
  gap: 20px !important;
  overflow-x: hidden !important;
  touch-action: pan-y !important;
  overscroll-behavior-x: contain !important;
  scrollbar-width: none !important;
  padding-inline: var(--pad-x, clamp(1rem, 4vw, 2rem)) !important;
  scroll-padding-inline: var(--pad-x, clamp(1rem, 4vw, 2rem)) !important;
  padding-block: 10px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  cursor: default;
}

:global(.prosthetics__slider::-webkit-scrollbar) {
  display: none !important;
}

/* ── Card Styling ── */
:global(.prosthetics-card) {
  flex: 0 0 clamp(310px, 30vw, 420px) !important;
  background: #ffffff;
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg, 20px);
  padding: 20px;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16px;
  user-select: none;
}

.prosthetics-card__header {
  border-bottom: 1px solid rgba(11, 42, 107, 0.07);
  padding-bottom: 10px;
}

.prosthetics-card__title {
  font-family: var(--font-display);
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.3;
  margin: 0;
}

/* ── Comparison Grid (Before / After side-by-side) ── */
.prosthetics-card__comparison {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.prosthetics-media {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* Badges — Neutral, refined medical styling */
.prosthetics-media__badge {
  align-self: flex-start;
  font-family: var(--font-display);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 4px 10px;
  border-radius: 6px;
  line-height: 1;
  background: #f0f6ff;
  color: var(--c-ink);
  border: 1px solid rgba(11, 42, 107, 0.12);
}

/* Frame & Placeholders — Unified neutral brand surface */
.prosthetics-media__frame {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 12px;
  overflow: hidden;
  background: #f0f6ff;
  border: 1px solid rgba(11, 42, 107, 0.08);
}

.prosthetics-media__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.prosthetics-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px;
  text-align: center;
  box-sizing: border-box;
  background: linear-gradient(135deg, #f8fafc 0%, #edf4fd 100%);
  color: #5b6b8a;
}

.prosthetics-placeholder__icon {
  color: #2e86f5;
  opacity: 0.75;
}

.prosthetics-placeholder__text {
  font-size: 0.75rem;
  font-weight: 600;
  color: #5b6b8a;
  line-height: 1.25;
}

/* ── Footer text ── */
.prosthetics-card__footer {
  padding-top: 4px;
}

.prosthetics-card__desc {
  font-size: 0.83rem;
  color: var(--c-muted);
  line-height: 1.45;
  margin: 0;
}

/* Mobile Responsiveness */
@media (max-width: 599px) {
  .prosthetics-card {
    flex: 0 0 295px !important;
    padding: 16px;
    gap: 12px;
  }

  .prosthetics__slider {
    gap: 14px !important;
  }
}
</style>

<script>
  function initProstheticsSlider() {
    const slider = document.getElementById('prosthetics-slider') as HTMLElement | null;
    const section = document.getElementById('prosthetics') as HTMLElement | null;
    if (!slider) return;

    let animId: number | null = null;
    let isVisibleInViewport = false;
    let pos = slider.scrollLeft;
    const speed = 0.75; // px per frame — smooth continuous marquee speed

    function getSingleSetWidth(): number {
      const firstCard = slider.querySelector('.prosthetics-card') as HTMLElement | null;
      if (!firstCard) return 2310;
      const count = parseInt(slider.getAttribute('data-case-count') || '7', 10);
      const gap = parseFloat(window.getComputedStyle(slider).gap) || 20;
      return count * (firstCard.offsetWidth + gap);
    }

    function syncPosition() {
      if (!slider) return;
      pos = slider.scrollLeft;
    }

    function tick() {
      if (!slider) return;

      const singleSetWidth = getSingleSetWidth();

      if (isVisibleInViewport && !document.hidden) {
        pos += speed;
        slider.scrollLeft = pos;
      }

      // Seamless loop reset in both scroll directions (forward and backward)
      if (pos >= singleSetWidth * 2) {
        pos -= singleSetWidth;
        slider.scrollLeft = pos;
      } else if (pos <= 5) {
        pos += singleSetWidth;
        slider.scrollLeft = pos;
      }

      if (isVisibleInViewport && !document.hidden) {
        animId = requestAnimationFrame(tick);
      } else {
        animId = null;
      }
    }

    function startAutoScroll() {
      if (!animId && isVisibleInViewport && !document.hidden) {
        syncPosition();
        animId = requestAnimationFrame(tick);
      }
    }

    function stopAutoScroll() {
      if (animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    }

    // Resync position on window resize or orientation change
    window.addEventListener('resize', syncPosition, { passive: true });

    // ── Performance Optimization 1: IntersectionObserver ──
    // Stop rAF loop entirely when the section is not visible on screen (0% CPU impact when scrolled away)
    if (section && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisibleInViewport = entry.isIntersecting;
          if (entry.isIntersecting) {
            startAutoScroll();
          } else {
            stopAutoScroll();
          }
        });
      }, { threshold: 0.02 });
      observer.observe(section);
    } else {
      isVisibleInViewport = true;
      startAutoScroll();
    }

    // ── Performance Optimization 2: Page Visibility API ──
    // Pause rAF loop when user switches browser tab or minimizes window
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoScroll();
      } else if (isVisibleInViewport) {
        startAutoScroll();
      }
    });
  }

  // Ensure script runs reliably whether DOMContentLoaded fired or not
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProstheticsSlider);
  } else {
    initProstheticsSlider();
  }
  document.addEventListener('astro:page-load', initProstheticsSlider);
</script>
