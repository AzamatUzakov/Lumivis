---
// SiteFooter — footer with mini booking form, social links, copyright
// ─────────────────────────────────────────────────────────────────────
// FORM INTEGRATION: Telegram Bot API
//   Required env vars (copy .env.example → .env and fill in values):
//     PUBLIC_TG_BOT_TOKEN — Telegram bot token from @BotFather
//     PUBLIC_TG_CHAT_ID   — Chat ID to send messages to (use @userinfobot to find it)
//
// TODO (РЕКВИЗИТЫ): Заполни данные владельца у клиента и раскомментируй блок
// "footer-requisites" ниже в HTML-разметке:
//   - Юридическое название организации [ЗАПОЛНИТЬ: ООО / МЧЖЖ / ИП ...]
//   - ИНН / ПИНФЛ                      [ЗАПОЛНИТЬ]
//   - Номер медицинской лицензии        [ЗАПОЛНИТЬ]
//   - Дата выдачи лицензии              [ЗАПОЛНИТЬ]
// ─────────────────────────────────────────────────────────────────────
import { Image } from "astro:assets";
import logoImg from "../assets/header-logo.png";

// Read Telegram credentials from env (Astro exposes PUBLIC_* vars to client)
const TG_BOT_TOKEN = import.meta.env.PUBLIC_TG_BOT_TOKEN ?? "";
const TG_CHAT_ID   = import.meta.env.PUBLIC_TG_CHAT_ID   ?? "";
---

<footer class="site-footer" id="footer">
  <div class="footer-top">
    <div class="container footer-top__inner">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Lumivis — на главную">
          <Image src={logoImg} alt="Lumivis" width={300} height={100} loading="lazy" format="webp" />
        </a>
        <p class="footer-tagline" data-i18n="footer.tagline">Офтальмологическая клиника в Самарканде</p>
        <div class="footer-social">
          <a href="https://t.me/NKernel" target="_blank" rel="noopener" class="footer-social__link" aria-label="Telegram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/abduqayyum_ocularist/" target="_blank" rel="noopener" class="footer-social__link" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="tel:+998995981010" class="footer-social__link" aria-label="Позвонить">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.67 10.37a19.79 19.79 0 01-3.07-8.67A2 2 0 012.58 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.53a16 16 0 006.56 6.56l.9-.9a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav -->
      <div class="footer-col">
        <h4 class="footer-col__title" data-i18n="footer.nav.title">Навигация</h4>
        <nav class="footer-nav">
          <a href="#doctors" class="footer-nav__link" data-i18n="nav.doctors">Врачи</a>
          <a href="#equipment" class="footer-nav__link" data-i18n="nav.equipment">Оборудование</a>
          <a href="#services" class="footer-nav__link" data-i18n="nav.services">Услуги</a>
          <a href="#retinopathy" class="footer-nav__link" data-i18n="nav.retinopathy">РН-скрининг</a>
          <a href="#results" class="footer-nav__link" data-i18n="nav.videos">Результаты</a>
          <a href="#contacts" class="footer-nav__link" data-i18n="nav.contacts">Контакты</a>
          <a href="/privacy" class="footer-nav__link footer-nav__link--legal" data-i18n="footer.privacy.link">Политика конфиденциальности</a>
        </nav>
      </div>

      <!-- Contacts -->
      <div class="footer-col">
        <h4 class="footer-col__title" data-i18n="footer.contact.title">Контакты</h4>
        <div class="footer-contacts">
          <a href="tel:+998995981010" class="footer-contacts__phone">+998 99 598 10 10</a>
          <p class="footer-contacts__hours" data-i18n="header.hours">Пн–Сб 09:00–17:00</p>
          <!-- TODO (АДРЕС): Уточнить точный адрес у владельца (улица, дом) и обновить
               data-i18n="map.address" в BaseLayout.astro — сейчас стоит:
               "г. Самарканд, Узбекистан" [ЗАПОЛНИТЬ: полный адрес] -->
          <p class="footer-contacts__address" data-i18n="map.address">г. Самарканд, Узбекистан</p>
          <!-- TODO (РЕКВИЗИТЫ): Раскомментируй когда получишь данные от клиента
          <p class="footer-contacts__requisites">
            [ЗАПОЛНИТЬ: юридическое название, напр. МЧЖЖ «Lumivis»]<br/>
            ИНН: [ЗАПОЛНИТЬ]<br/>
            Лицензия №[ЗАПОЛНИТЬ] от [ЗАПОЛНИТЬ]<br/>
          </p>
          -->
          <div class="footer-contacts__socials">
            <a href="https://t.me/NKernel" target="_blank" rel="noopener" class="footer-contacts__social-link">
              Telegram: @NKernel
            </a>
          </div>
        </div>
      </div>

      <!-- Mini Booking Form -->
      <div class="footer-col footer-form-col">
        <h4 class="footer-col__title" data-i18n="footer.booking.title">Записаться на приём</h4>
        <form class="footer-form" id="booking-form" novalidate>
          <input
            type="text"
            id="footer-name"
            name="name"
            class="footer-form__input"
            placeholder="Ваше имя"
            data-i18n-placeholder="footer.name.placeholder"
            required
            autocomplete="name"
          />
          <input
            type="tel"
            id="footer-phone"
            name="phone"
            class="footer-form__input"
            placeholder="Номер телефона"
            data-i18n-placeholder="footer.phone.placeholder"
            required
            autocomplete="tel"
          />

          <!-- Consent checkbox (required by law for medical data processing) -->
          <label class="footer-form__consent" id="consent-label">
            <input
              type="checkbox"
              id="footer-consent"
              name="consent"
              class="footer-form__consent-checkbox"
              required
            />
            <span class="footer-form__consent-text">
              <span data-i18n="footer.consent.text">Я согласен(на) на обработку указанных персональных данных (имя и телефон) в целях записи на приём и связи со мной как с пациентом клиники Lumivis. Данные не передаются третьим лицам и не используются в рекламных целях. Подробнее:</span>
              <a href="/privacy" class="footer-form__consent-link" data-i18n="footer.consent.link">Политика конфиденциальности</a>
            </span>
          </label>

          <div class="footer-form__error" id="consent-error" role="alert" aria-live="polite" hidden>
            Пожалуйста, дайте согласие на обработку данных
          </div>

          <button type="submit" id="booking-submit" class="btn btn--primary footer-form__submit" data-i18n="footer.submit">
            Отправить заявку
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p class="footer-copyright" data-i18n="footer.copyright">© 2025 Lumivis. Все права защищены.</p>
      <a href="#hero" class="footer-scroll-top" aria-label="Наверх">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <polyline points="18 15 12 9 6 15"/>
        </svg>
        Наверх
      </a>
    </div>
  </div>
</footer>

<script define:vars={{ TG_BOT_TOKEN, TG_CHAT_ID }}>
  var form = document.getElementById('booking-form');
  var consentError = document.getElementById('consent-error');

  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      var nameInput  = form.querySelector('[name="name"]');
      var phoneInput = form.querySelector('[name="phone"]');
      var consentBox = form.querySelector('[name="consent"]');
      var btn        = document.getElementById('booking-submit');

      var name  = (nameInput  && nameInput.value)  ? nameInput.value.trim()  : '';
      var phone = (phoneInput && phoneInput.value) ? phoneInput.value.trim() : '';

      // Guard: require non-empty fields
      if (!name || !phone) return;

      // Guard: consent checkbox must be checked
      if (!consentBox || !consentBox.checked) {
        if (consentError) consentError.hidden = false;
        if (consentBox) consentBox.focus();
        return;
      }
      if (consentError) consentError.hidden = true;

      // ── Telegram Bot API send ─────────────────────────────────────────
      var botToken = TG_BOT_TOKEN;
      var chatId   = TG_CHAT_ID;

      if (btn) {
        btn.disabled = true;
        btn.textContent = '⏳ Отправка...';
      }

      if (botToken && chatId) {
        try {
          var text =
            '📋 *Новая заявка — Lumivis*\n' +
            '👤 Имя: ' + name + '\n' +
            '📞 Телефон: ' + phone + '\n' +
            '🕐 Время: ' + new Date().toLocaleString('ru-RU', { timeZone: 'Asia/Samarkand' });

          var res = await fetch(
            'https://api.telegram.org/bot' + botToken + '/sendMessage',
            {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ chat_id: chatId, text: text, parse_mode: 'Markdown' }),
            }
          );

          if (!res.ok) {
            console.error('[Lumivis] Telegram API error:', res.status);
          }
        } catch (err) {
          console.error('[Lumivis] Failed to send to Telegram:', err);
        }
      } else {
        console.warn('[Lumivis] Telegram credentials not configured. Form data:', { name: name, phone: phone });
      }
      // ─────────────────────────────────────────────────────────────────

      if (btn) {
        btn.textContent = '✓ Заявка отправлена!';
        btn.style.background = 'var(--c-teal)';
      }
      form.reset();
    });

    // Hide consent error when checkbox is ticked
    var cb = form.querySelector('[name="consent"]');
    if (cb) {
      cb.addEventListener('change', function() {
        if (consentError && cb.checked) consentError.hidden = true;
      });
    }
  }
</script>

<style>
.site-footer {
  background: #0b1628;
  color: rgba(255,255,255,0.75);
}

.footer-top {
  padding-block: clamp(2.5rem, 6vw, 4rem);
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.footer-top__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-8);
}

/* Brand */
.footer-brand {
  display: flex;
  flex-direction: column;
  gap: var(--s-4);
}

.footer-logo {
  display: inline-block;
  line-height: 1;
}

.footer-logo img {
  filter: brightness(0) invert(1);
  opacity: 0.95;
  height: 40px;
  width: auto;
  object-fit: contain;
  display: block;
}

.footer-tagline {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
  max-width: 22ch;
}

.footer-social {
  display: flex;
  gap: var(--s-3);
}

.footer-social__link {
  width: 38px;
  height: 38px;
  border-radius: var(--r-full);
  background: rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.65);
  transition: all var(--t-fast);
}

.footer-social__link:hover {
  background: var(--c-sky);
  color: var(--c-white);
}

/* Columns */
.footer-col__title {
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--c-white);
  letter-spacing: 0.02em;
  margin-bottom: var(--s-4);
}

/* Nav */
.footer-nav {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.footer-nav__link {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.6);
  transition: color var(--t-fast), padding-left var(--t-fast);
}

.footer-nav__link:hover {
  color: var(--c-sky-light);
  padding-left: var(--s-2);
}

/* Contacts */
.footer-contacts {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.footer-contacts__phone {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--c-white);
  transition: color var(--t-fast);
}

.footer-contacts__phone:hover {
  color: var(--c-sky-light);
}

.footer-contacts__hours,
.footer-contacts__address {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.55);
}

.footer-contacts__socials {
  margin-top: var(--s-2);
}

.footer-contacts__social-link {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.55);
  transition: color var(--t-fast);
}

.footer-contacts__social-link:hover {
  color: var(--c-sky-light);
}

/* Form */
.footer-form {
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
}

.footer-form__input {
  background: rgba(255,255,255,0.07);
  border: 1.5px solid rgba(255,255,255,0.12);
  border-radius: var(--r-md);
  padding: 0.7rem 1rem;
  color: var(--c-white);
  font-family: var(--font-body);
  font-size: 0.9rem;
  transition: border-color var(--t-fast), background var(--t-fast);
  width: 100%;
}

.footer-form__input::placeholder {
  color: rgba(255,255,255,0.35);
}

.footer-form__input:focus {
  outline: none;
  border-color: var(--c-sky);
  background: rgba(255,255,255,0.1);
}

.footer-form__submit {
  width: 100%;
  justify-content: center;
}

/* Consent checkbox */
.footer-form__consent {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  cursor: pointer;
  padding-top: var(--s-1);
}

.footer-form__consent-checkbox {
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  margin-top: 2px;
  accent-color: var(--c-sky);
  cursor: pointer;
}

.footer-form__consent-text {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.55;
}

.footer-form__consent-link {
  color: var(--c-sky-light);
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color var(--t-fast);
  margin-left: 0.25em;
}

.footer-form__consent-link:hover {
  color: var(--c-white);
}

.footer-form__error {
  font-size: 0.78rem;
  color: #ff8a8a;
  padding: 0.35rem 0.5rem;
  border-left: 2px solid #ff8a8a;
  margin-top: calc(-1 * var(--s-1));
}

/* Legal link in nav (slightly dimmer + italic to visually separate from section links) */
.footer-nav__link--legal {
  font-style: italic;
  opacity: 0.65;
  margin-top: var(--s-1);
}

/* Bottom bar */
.footer-bottom {
  padding-block: var(--s-4);
}

.footer-bottom__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-4);
  flex-wrap: wrap;
}

.footer-copyright {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.35);
}

.footer-scroll-top {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-size: 0.8rem;
  color: rgba(255,255,255,0.4);
  transition: color var(--t-fast);
}

.footer-scroll-top:hover {
  color: var(--c-sky-light);
}

/* Responsive */
@media (min-width: 640px) {
  .footer-top__inner {
    grid-template-columns: repeat(2, 1fr);
  }
  .footer-form-col {
    grid-column: span 2;
  }
}

@media (min-width: 1024px) {
  .footer-top__inner {
    grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
  }
  .footer-form-col {
    grid-column: span 1;
  }
}
</style>
