---
// RetinopathySection v2 — warm navy, refined
---

<section class="rn section--navy" id="retinopathy">
  <div class="container rn__inner">
    <!-- LEFT: Text -->
    <div class="rn__content">
      <span class="eyebrow eyebrow--white rn__eyebrow" data-i18n="rn.badge">Уникальная компетенция</span>
      <div class="rn__amber-accent" aria-hidden="true"></div>

      <h2 class="rn__title" data-i18n="rn.title">
        Единственная клиника в Самарканде, где выявляют и ведут ретинопатию недоношенных
      </h2>

      <p class="rn__text" data-i18n="rn.text">
        Ретинопатия недоношенных — опасное состояние, при котором недоразвитые сосуды сетчатки
        у недоношенного ребёнка могут привести к потере зрения. Раннее выявление — в первые 3–6 недель
        жизни — позволяет начать лечение до необратимых последствий.
      </p>

      <p class="rn__text" data-i18n="rn.text2">
        Мы работаем совместно с педиатрическими учреждениями Самарканда и принимаем детей
        с первых недель жизни.
      </p>

      <div class="rn__facts">
        <div class="rn__fact">
          <span class="rn__fact-num">3–6</span>
          <span class="rn__fact-label">недель — оптимальный срок первого осмотра</span>
        </div>
        <div class="rn__fact">
          <span class="rn__fact-num">1</span>
          <span class="rn__fact-label">клиника в Самарканде ведёт РН-скрининг</span>
        </div>
      </div>

      <a href="#contacts" class="btn btn--amber rn__cta" data-i18n="rn.cta">
        Записать ребёнка
      </a>
    </div>

    <!-- RIGHT: Photo -->
    <div class="rn__visual">
      <img
        src="/IMG_0345.JPG"
        alt="Врачи проводят офтальмоскопию новорождённому"
        class="rn__img"
        loading="lazy"
        decoding="async"
        width="600"
        height="450"
      />
    </div>
  </div>
</section>

<style>
.rn {
  padding-block: clamp(4rem, 9vw, 7rem);
}

.rn__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-12);
  align-items: center;
}

.rn__eyebrow {
  display: block;
  margin-bottom: var(--s-4);
}

.rn__amber-accent {
  width: 48px;
  height: 2px;
  background: var(--c-amber);
  margin-bottom: var(--s-6);
}

.rn__title {
  color: var(--c-white);
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  line-height: 1.2;
  margin-bottom: var(--s-6);
}

.rn__text {
  color: rgba(255,255,255,0.65);
  font-size: 0.9rem;
  line-height: 1.8;
  margin-bottom: var(--s-4);
  max-width: 50ch;
}

.rn__facts {
  display: flex;
  gap: var(--s-10);
  margin-block: var(--s-8);
  padding-top: var(--s-6);
  border-top: 1px solid rgba(255,255,255,0.1);
}

.rn__fact {
  display: flex;
  flex-direction: column;
  gap: var(--s-1);
}

.rn__fact-num {
  font-family: var(--font-display);
  font-size: 2.25rem;
  color: var(--c-amber-lt);
  line-height: 1;
  letter-spacing: -0.02em;
}

.rn__fact-label {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.45);
  line-height: 1.5;
  max-width: 16ch;
}

.rn__cta { display: inline-flex; }

.rn__visual { display: flex; justify-content: center; }

.rn__img {
  width: 100%;
  max-width: 520px;
  height: auto;
  border-radius: var(--r-lg);
  object-fit: cover;
  box-shadow: 0 32px 80px rgba(0,0,0,0.35);
  /* Слабый тёмный оверлей для единообразия с navy фоном */
  filter: brightness(0.92) contrast(1.02);
}

@media (min-width: 900px) {
  .rn__inner { grid-template-columns: 1fr 1fr; gap: var(--s-16); }
}
</style>
