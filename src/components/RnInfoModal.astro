---
import { Image } from "astro:assets";
import eyeDiagram from "../assets/gallery/rn-eye-diagram.png";
---

<dialog id="rn-info-modal" class="rn-modal" aria-labelledby="rn-modal-title" aria-describedby="rn-modal-subtitle">
  <div class="rn-modal__backdrop" data-close-rn-modal></div>
  <div class="rn-modal__container" role="document">
    
    <!-- Modal Header -->
    <header class="rn-modal__header">
      <div class="rn-modal__header-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2"/>
        </svg>
      </div>
      <div class="rn-modal__header-text">
        <h2 id="rn-modal-title" class="rn-modal__title" data-i18n="rn.modal.title">
          Ретинопатия недоношенных (РН)
        </h2>
        <p id="rn-modal-subtitle" class="rn-modal__subtitle" data-i18n="rn.modal.subtitle">
          Официальная медицинская брошюра клиники Lumivis
        </p>
      </div>
      <button type="button" class="rn-modal__close-icon" data-close-rn-modal aria-label="Закрыть модальное окно">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </header>

    <!-- Scrollable Body Content -->
    <div class="rn-modal__body">
      
      <!-- Section 1: Definition -->
      <section class="rn-modal__section">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.p1_title">Что такое ретинопатия недоношенных?</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.p1_text">
          РН (Ретинопатия недоношенных) — это тяжёлое заболевание глаз у недоношенных детей, возникающее из-за наличия аваскулярной (безсосудистой) зоны сетчатки и аномального развития сосудов (роста новых сосудов и фиброваскулярной ткани), что может привести к отслойке сетчатки и неизлечимой инвалидности по зрению.
        </p>
      </section>

      <!-- Section 2: Vascular Timeline -->
      <section class="rn-modal__section">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.p2_title">Сроки развития сосудов сетчатки</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.p2_text">
          В норме у плода сосуды сетчатки начинают развиваться с 12–16 недель беременности, и этот процесс продолжается до 38–40 недель.
        </p>
      </section>

      <!-- Section 3: Pathology Mechanism -->
      <section class="rn-modal__section">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.p3_title">Механизм развития патологии</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.p3_text">
          Нарушение нормального физиологического формирования сосудов сетчатки приводит к извилистости сосудов и образованию новых патологических сосудов на демаркационной линии между сосудистой и безсосудистой зонами. Это влечёт за собой рост фиброваскулярной ткани в сторону переднего отрезка глаза (за хрусталик), натяжение и отслойку сетчатки.
        </p>
      </section>

      <!-- Section 4: Critical Window -->
      <section class="rn-modal__section">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.p4_title">Критический период наблюдения и скрининг</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.p4_text">
          Заболевание развивается преимущественно на 5–15 неделях после рождения (в этот период ребёнок обязательно должен находиться под наблюдением офтальмолога). Осмотр глазного дна детским окулистом в эти сроки строго обязателен.
        </p>
      </section>

      <!-- Section 5: Stages & Consequences -->
      <section class="rn-modal__section">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.p5_title">Стадии болезни и риски</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.p5_text">
          Заболевание проходит 5 стадий. Без своевременного лечения и профилактических мер болезнь может привести к пожизненной необратимой слепоте. Скрининг продолжается 4–5 месяцев.
        </p>
      </section>

      <!-- Section 6: VEGF Factor -->
      <section class="rn-modal__section">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.p6_title">Фактор VEGF</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.p6_text">
          Фактором, вызывающим неоваскуляризацию (патологический рост сосудов), является VEGF (сосудистый эндотелиальный фактор роста), вырабатываемый тканью сетчатки в условиях гипоксии (нехватки кислорода).
        </p>
      </section>

      <!-- Section 7: Risk Factors List -->
      <section class="rn-modal__section rn-modal__section--risk">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.risk_title">Факторы риска развития заболевания:</h3>
        <ul class="rn-modal__risk-list">
          <li data-i18n="rn.modal.risk_1">Масса тела при рождении менее 2000 г;</li>
          <li data-i18n="rn.modal.risk_2">Срок гестации менее 35 недель;</li>
          <li data-i18n="rn.modal.risk_3">Задержка внутриутробного развития плода;</li>
          <li data-i18n="rn.modal.risk_4">Длительная оксигенотерапия (подача кислорода);</li>
          <li data-i18n="rn.modal.risk_5">Многоплодная беременность.</li>
        </ul>
      </section>

      <!-- Section 8: Eye Diagram Scheme -->
      <figure class="rn-modal__diagram">
        <Image
          src={eyeDiagram}
          alt="Схема глаза: сравнение здоровой сетчатки и сетчатки при ретинопатии недоношенных"
          class="rn-modal__diagram-img"
          width={700}
          height={320}
          format="webp"
          quality={85}
          loading="lazy"
        />
        <figcaption class="rn-modal__diagram-caption" data-i18n="rn.modal.diagram_caption">
          Схема: Сравнение здоровой сетчатки и сетчатки при ретинопатии недоношенных (РН)
        </figcaption>
      </figure>

      <!-- Section 9: Treatment & Call to Action -->
      <section class="rn-modal__section rn-modal__section--treatment">
        <h3 class="rn-modal__section-title" data-i18n="rn.modal.treatment_title">Лечение:</h3>
        <p class="rn-modal__p" data-i18n="rn.modal.treatment_text">
          Главным звеном сохранения зрения является своевременное проведение Anti-VEGF терапии (интравитреальная инъекция для остановки неоваскуляризации) на начальных стадиях заболевания.
        </p>

        <blockquote class="rn-modal__quote">
          <p data-i18n="rn.modal.closing">
            Не будьте равнодушны к возможности вашего ребёнка видеть этот мир, ведь он имеет право видеть наравне со всеми!
          </p>
        </blockquote>
      </section>

    </div>

    <!-- Modal Footer Actions -->
    <footer class="rn-modal__footer">
      <a href="#booking-form-section" class="btn btn--primary rn-modal__book-btn" id="rn-modal-book-btn" data-i18n="rn.modal.book">
        Записаться на РН-скрининг
      </a>
      <button type="button" class="btn btn--outline rn-modal__cancel-btn" data-close-rn-modal data-i18n="rn.modal.close">
        Закрыть
      </button>
    </footer>

  </div>
</dialog>

<style>
/* ── Modal Dialog Styles ── */
.rn-modal {
  padding: 0;
  border: none;
  background: transparent;
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  max-height: 100vh;
  margin: 0;
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.rn-modal:not([open]) {
  display: none;
}

.rn-modal__backdrop {
  position: fixed;
  inset: 0;
  background: rgba(11, 24, 48, 0.72);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1;
  animation: rnFadeIn 220ms ease-out forwards;
}

.rn-modal__container {
  position: relative;
  z-index: 2;
  width: min(680px, 92vw);
  max-height: 88vh;
  background: #ffffff;
  border-radius: 24px;
  box-shadow: 0 24px 60px rgba(11, 42, 107, 0.28), 0 0 0 1px rgba(11, 42, 107, 0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: rnPopIn 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Header */
.rn-modal__header {
  padding: 20px 24px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  border-bottom: 1px solid rgba(11, 42, 107, 0.08);
  background: #f8fbff;
  flex-shrink: 0;
}

.rn-modal__header-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: #eaf2ff;
  color: #2e86f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rn-modal__header-text {
  flex: 1;
  min-width: 0;
}

.rn-modal__title {
  font-family: var(--font-display);
  font-size: 1.18rem;
  font-weight: 700;
  color: #0b2a6b;
  margin: 0 0 2px;
  line-height: 1.25;
}

.rn-modal__subtitle {
  font-size: 0.82rem;
  color: #5b6b8a;
  margin: 0;
}

.rn-modal__close-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: none;
  background: rgba(11, 42, 107, 0.06);
  color: #5b6b8a;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
  flex-shrink: 0;
}

.rn-modal__close-icon:hover {
  background: rgba(11, 42, 107, 0.12);
  color: #0b2a6b;
}

/* Body */
.rn-modal__body {
  padding: 22px 24px;
  overflow-y: auto;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 18px;
  scrollbar-width: thin;
  scrollbar-color: rgba(11, 42, 107, 0.2) transparent;
}

.rn-modal__section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.rn-modal__section-title {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  color: #0b2a6b;
  margin: 0;
}

.rn-modal__p {
  font-size: 0.9rem;
  line-height: 1.6;
  color: #384860;
  margin: 0;
}

/* Risk Section Card */
.rn-modal__section--risk {
  background: #f4f8ff;
  border: 1px solid rgba(46, 134, 245, 0.18);
  border-radius: 16px;
  padding: 16px 18px;
}

.rn-modal__risk-list {
  margin: 4px 0 0;
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.rn-modal__risk-list li {
  font-size: 0.88rem;
  color: #1e3a70;
  line-height: 1.45;
  font-weight: 500;
}

/* Diagram Figure */
.rn-modal__diagram {
  margin: 4px 0;
  text-align: center;
  background: #ffffff;
  border: 1px solid rgba(11, 42, 107, 0.1);
  border-radius: 16px;
  padding: 14px;
  box-shadow: 0 4px 14px rgba(11, 42, 107, 0.04);
}

.rn-modal__diagram-img {
  width: 100%;
  height: auto;
  max-width: 540px;
  border-radius: 8px;
  display: block;
  margin: 0 auto;
}

.rn-modal__diagram-caption {
  font-size: 0.8rem;
  color: #6a7b98;
  margin-top: 8px;
  font-style: italic;
}

/* Quote */
.rn-modal__quote {
  margin: 8px 0 0;
  padding: 14px 16px;
  background: rgba(46, 134, 245, 0.08);
  border-left: 4px solid var(--c-sky);
  border-radius: 0 12px 12px 0;
}

.rn-modal__quote p {
  font-family: var(--font-display);
  font-size: 0.92rem;
  font-weight: 600;
  color: #0b2a6b;
  margin: 0;
  line-height: 1.5;
}

/* Footer */
.rn-modal__footer {
  padding: 16px 24px;
  border-top: 1px solid rgba(11, 42, 107, 0.08);
  background: #f8fbff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  flex-shrink: 0;
}

.rn-modal__book-btn {
  padding: 0.65rem 1.4rem;
  font-size: 0.88rem;
  font-weight: 600;
  border-radius: 100px;
}

.rn-modal__cancel-btn {
  padding: 0.62rem 1.25rem;
  font-size: 0.85rem;
  border-radius: 100px;
}

/* Keyframe Animations */
@keyframes rnFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes rnPopIn {
  from { opacity: 0; transform: scale(0.94) translateY(12px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@media (max-width: 599px) {
  .rn-modal__container {
    width: 94vw;
    max-height: 90vh;
    border-radius: 20px;
  }

  .rn-modal__header {
    padding: 16px 18px 12px;
  }

  .rn-modal__title {
    font-size: 1.05rem;
  }

  .rn-modal__body {
    padding: 16px 18px;
    gap: 14px;
  }

  .rn-modal__footer {
    padding: 14px 18px;
    flex-direction: column-reverse;
  }

  .rn-modal__book-btn,
  .rn-modal__cancel-btn {
    width: 100%;
    justify-content: center;
  }
}
</style>

<script>
  // Modal Controller Script
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("rn-info-modal") as HTMLDialogElement | null;
    if (!modal) return;

    // Function to open modal
    function openModal() {
      if (modal && !modal.open) {
        modal.showModal();
        document.body.style.overflow = "hidden";
      }
    }

    // Function to close modal
    function closeModal() {
      if (modal && modal.open) {
        modal.close();
        document.body.style.overflow = "";
      }
    }

    // Attach click listeners to all open trigger elements
    document.querySelectorAll("[data-open-rn-modal]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Attach click listeners to all close buttons/backdrop
    document.querySelectorAll("[data-close-rn-modal]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        closeModal();
      });
    });

    // Close on book button click and smooth scroll to form
    const bookBtn = document.getElementById("rn-modal-book-btn");
    if (bookBtn) {
      bookBtn.addEventListener("click", (e) => {
        e.preventDefault();
        closeModal();
        setTimeout(() => {
          const formSec = document.getElementById("booking-form-section") || document.getElementById("contacts");
          if (formSec) {
            formSec.scrollIntoView({ behavior: "smooth" });
          }
        }, 150);
      });
    }

    // Close on backdrop click
    modal.addEventListener("click", (e) => {
      const rect = modal.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        closeModal();
      }
    });

    // Handle Esc key
    modal.addEventListener("cancel", () => {
      document.body.style.overflow = "";
    });
  });
</script>
