---
interface Props {
  title?: string;
}

const { title = "Lumivis Lending" } = Astro.props;
---

<header class="header">
  <div class="container">
    <a href="/" class="logo">{title}</a>
    <nav class="nav">
      <slot />
    </nav>
  </div>
</header>

<style>
  .header {
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }
  .nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
</style>
