---
// DoctorsSection — 8 team cards with smooth bottom fade to white
const doctors = [
  { id: 1, image: "/doctors/doctor-3.png", bgClass: "doctor-card__photo--3" },
  { id: 2, image: "/doctors/doctor-2.png", bgClass: "doctor-card__photo--2" },
  { id: 3, image: "/doctors/doctor-5.png", bgClass: "doctor-card__photo--5" },
  { id: 4, image: "/doctors/doctor-6.png", bgClass: "doctor-card__photo--6" },
  { id: 5, image: "/doctors/doctor-7.png", bgClass: "doctor-card__photo--7" },
  { id: 6, image: "/doctors/doctor-4.png", bgClass: "doctor-card__photo--4" },
  { id: 7, image: "/doctors/doctor-8.png", bgClass: "doctor-card__photo--8" },
  { id: 8, image: "/doctors/doctor-1.png", bgClass: "doctor-card__photo--1" },
];
---

<section class="doctors section" id="doctors">
  <div class="container">
    <div class="section-header">
      <h2 data-i18n="doctors.title">Наша команда</h2>
      <p data-i18n="doctors.subtitle">Специалисты с многолетним опытом в офтальмологии взрослых и детей</p>
    </div>

    <div class="doctors__grid">
      {doctors.map((doc) => (
        <article class="doctor-card">
          <div class={`doctor-card__photo ${doc.bgClass}`}>
            {doc.image ? (
              <img
                src={doc.image}
                alt={`Врач-офтальмолог ${doc.id}`}
                class="doctor-card__img"
                loading="lazy"
              />
            ) : (
              <div class="doctor-card__placeholder" aria-hidden="true">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                  <circle cx="12" cy="8" r="5"/>
                  <path d="M3 21c0-5 3.5-9 9-9s9 4 9 9"/>
                </svg>
              </div>
            )}
          </div>
          <div class="doctor-card__info">
            <h3 class="doctor-card__name" data-i18n={`doctor.${doc.id}.name`}>Врач-офтальмолог #{doc.id}</h3>
            <p class="doctor-card__spec" data-i18n={`doctor.${doc.id}.spec`}>Специализация уточняется</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.doctors__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-6);
}

.doctor-card {
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  background: var(--c-white);
  border: 1px solid var(--c-border);
}

/* Photo container with background gradients */
.doctor-card__photo {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 3px solid var(--c-teal);
}

/* Rich background themes for photos */
.doctor-card__photo--1 { background: linear-gradient(160deg, #e8f2fe 0%, #c8e0fd 100%); }
.doctor-card__photo--2 { background: linear-gradient(160deg, #e0f2fe 0%, #bae6fd 100%); }
.doctor-card__photo--3 { background: linear-gradient(160deg, #f0fdf4 0%, #bbf7d0 100%); }
.doctor-card__photo--4 { background: linear-gradient(160deg, #f5f3ff 0%, #ddd6fe 100%); }
.doctor-card__photo--5 { background: linear-gradient(160deg, #e0e7ff 0%, #c7d2fe 100%); }
.doctor-card__photo--6 { background: linear-gradient(160deg, #ecfeff 0%, #a5f3fc 100%); }
.doctor-card__photo--7 { background: linear-gradient(160deg, #f1f5f9 0%, #cbd5e1 100%); }
.doctor-card__photo--8 { background: linear-gradient(160deg, #f0fdfa 0%, #99f6e4 100%); }

.doctor-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  position: relative;
  z-index: 1;
}

.doctor-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(11, 42, 107, 0.35);
  position: relative;
  z-index: 1;
}

/* Info block under photo */
.doctor-card__info {
  position: relative;
  z-index: 3;
  background: var(--c-white);
  padding: var(--s-5);
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  text-align: left;
}

.doctor-card__name {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.3;
  text-align: left;
}

.doctor-card__spec {
  font-size: 0.9rem;
  color: var(--c-muted);
  line-height: 1.4;
  text-align: left;
}

/* Responsive Grid */
@media (min-width: 600px) {
  .doctors__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 900px) {
  .doctors__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1200px) {
  .doctors__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
</style>
