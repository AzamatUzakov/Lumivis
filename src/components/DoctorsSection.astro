---
// DoctorsSection v2 — editorial, warm, elegant portrait placeholders
---

<section class="doctors section" id="doctors">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow eyebrow--amber">Экспертиза и опыт</span>
      <h2 data-i18n="doctors.title">Наша команда</h2>
      <p data-i18n="doctors.subtitle">Специалисты с многолетним опытом в офтальмологии взрослых и детей</p>
    </div>

    <div class="doctors__grid">

      <!-- Doctor 1 -->
      <article class="doc-card">
        <div class="doc-card__photo-frame">
          <div class="doc-card__avatar doc-card__avatar--1">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <circle cx="12" cy="8" r="5"/>
              <path d="M3 21c0-5 3.5-9 9-9s9 4 9 9"/>
            </svg>
          </div>
          <div class="doc-card__tag">РН-скрининг</div>
        </div>
        <div class="doc-card__body">
          <h3 class="doc-card__name" data-i18n="doctor.1.name">Врач-офтальмолог</h3>
          <p class="doc-card__spec" data-i18n="doctor.1.spec">Детская офтальмология, РН-скрининг</p>
          <div class="doc-card__footer">
            <span class="doc-card__exp" data-i18n="doctor.1.exp">Стаж: уточняется</span>
            <a href="#contacts" class="doc-card__link" data-i18n="header.cta">Записаться →</a>
          </div>
        </div>
      </article>

      <!-- Doctor 2 -->
      <article class="doc-card">
        <div class="doc-card__photo-frame">
          <div class="doc-card__avatar doc-card__avatar--2">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <circle cx="12" cy="8" r="5"/>
              <path d="M3 21c0-5 3.5-9 9-9s9 4 9 9"/>
            </svg>
          </div>
          <div class="doc-card__tag">Хирургия</div>
        </div>
        <div class="doc-card__body">
          <h3 class="doc-card__name" data-i18n="doctor.2.name">Врач-офтальмолог</h3>
          <p class="doc-card__spec" data-i18n="doctor.2.spec">Хирургия косоглазия, аппаратное лечение</p>
          <div class="doc-card__footer">
            <span class="doc-card__exp" data-i18n="doctor.2.exp">Стаж: уточняется</span>
            <a href="#contacts" class="doc-card__link" data-i18n="header.cta">Записаться →</a>
          </div>
        </div>
      </article>

      <!-- Doctor 3 -->
      <article class="doc-card">
        <div class="doc-card__photo-frame">
          <div class="doc-card__avatar doc-card__avatar--3">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <circle cx="12" cy="8" r="5"/>
              <path d="M3 21c0-5 3.5-9 9-9s9 4 9 9"/>
            </svg>
          </div>
          <div class="doc-card__tag">Диагностика</div>
        </div>
        <div class="doc-card__body">
          <h3 class="doc-card__name" data-i18n="doctor.3.name">Врач-офтальмолог</h3>
          <p class="doc-card__spec" data-i18n="doctor.3.spec">Диагностика и лечение взрослых</p>
          <div class="doc-card__footer">
            <span class="doc-card__exp" data-i18n="doctor.3.exp">Стаж: уточняется</span>
            <a href="#contacts" class="doc-card__link" data-i18n="header.cta">Записаться →</a>
          </div>
        </div>
      </article>

    </div>

    <p class="doctors__note" data-i18n="doctors.photo.soon">* Фотографии врачей будут обновлены клиникoй</p>
  </div>
</section>

<style>
.doctors__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-6);
}

.doc-card {
  background: var(--c-white);
  border: 1px solid var(--c-border-lt);
  border-radius: var(--r-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}

.doc-card:hover {
  border-color: var(--c-border);
  box-shadow: var(--shadow-card);
}

.doc-card__photo-frame {
  position: relative;
  aspect-ratio: 4 / 4.5;
  background: var(--c-stone);
  overflow: hidden;
}

.doc-card__avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-navy);
  opacity: 0.25;
}

.doc-card__avatar--1 { background: #EAE6DF; }
.doc-card__avatar--2 { background: #E6ECE8; }
.doc-card__avatar--3 { background: #E5E9F0; }

.doc-card__tag {
  position: absolute;
  top: var(--s-4);
  left: var(--s-4);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  border: 1px solid var(--c-border);
  padding: 0.25rem 0.65rem;
  border-radius: var(--r-sm);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--c-navy);
  letter-spacing: 0.03em;
}

.doc-card__body {
  padding: var(--s-6);
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  flex: 1;
}

.doc-card__name {
  font-family: var(--font-display);
  font-size: 1.35rem;
  color: var(--c-navy);
  line-height: 1.2;
}

.doc-card__spec {
  font-size: 0.85rem;
  color: var(--c-body);
  line-height: 1.5;
}

.doc-card__footer {
  margin-top: auto;
  padding-top: var(--s-4);
  border-top: 1px solid var(--c-border-lt);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-2);
}

.doc-card__exp {
  font-size: 0.78rem;
  color: var(--c-muted);
}

.doc-card__link {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--c-amber);
  transition: color var(--t-fast);
}

.doc-card__link:hover {
  color: var(--c-amber-lt);
}

.doctors__note {
  text-align: center;
  margin-top: var(--s-8);
  font-size: 0.8rem;
  color: var(--c-muted);
  font-style: italic;
}

@media (min-width: 640px) {
  .doctors__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1024px) {
  .doctors__grid { grid-template-columns: repeat(3, 1fr); }
}
</style>
