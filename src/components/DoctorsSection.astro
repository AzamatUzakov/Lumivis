---
// DoctorsSection.astro — 2-zone card: photo on white bg + solid branded text panel
const doctors = [
  { id: 1, image: "/doctors/doctor-3.png", pos: "center 10%",
    nameRu: "Бобоев Саидафзал Абдурахманович", specRu: "Офтальмохирург, к.м.н., доцент" },
  { id: 2, image: "/doctors/doctor-2.png", pos: "center 10%",
    nameRu: "Ражабов Санжар Мансурович", specRu: "Офтальмохирург, катарактолог" },
  { id: 3, image: "/doctors/doctor-5.png", pos: "center 10%",
    nameRu: "Абдурахмонов Фаридун Саидакбарович", specRu: "Детский офтальмолог, страбизмолог" },
  { id: 4, image: "/doctors/doctor-6.png", pos: "center 22%",
    nameRu: "Раупова Парвина Хасановна", specRu: "Врач-окулист" },
  { id: 5, image: "/doctors/doctor-7.png", pos: "center 10%",
    nameRu: "Зикириллоев Абдурасул Нусратиллоевич", specRu: "Офтальмохирург-катарактолог, главный врач" },
  { id: 6, image: "/doctors/doctor-4.png", pos: "center 10%",
    nameRu: "Мусинов Абдукаюм Суюнбоевич", specRu: "Врач-окулист" },
  { id: 7, image: "/doctors/doctor-8.png", pos: "center 10%",
    nameRu: "Мусинов Хусниддин Суюнбоевич", specRu: "Окулярист" },
  { id: 8, image: "/doctors/doctor-1.png", pos: "center 10%",
    nameRu: "Бобоев Сиёвуш Саидафзалзода", specRu: "Офтальмохирург, Ph.D" },
];
---

<section class="doctors section" id="doctors">
  <div class="container">
    <div class="section-header">
      <h2 data-i18n="doctors.title">Наша команда</h2>
      <p data-i18n="doctors.subtitle">Специалисты с многолетним опытом в офтальмологии взрослых и детей</p>
    </div>

    <div class="doctors__grid">
      {doctors.map((doc) => (
        <article class="doctor-card">
          <!-- Photo zone: white bg matches studio photos -->
          <div class="doctor-card__photo-wrap">
            {doc.image ? (
              <img
                src={doc.image}
                alt={`${doc.nameRu}, ${doc.specRu}`}
                class="doctor-card__img"
                style={{ objectPosition: doc.pos || "center 10%" }}
                loading="lazy"
              />
            ) : (
              <div class="doctor-card__placeholder" aria-hidden="true">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                  <circle cx="12" cy="8" r="5"/>
                  <path d="M3 21c0-5 3.5-9 9-9s9 4 9 9"/>
                </svg>
              </div>
            )}
          </div>

          <!-- Text zone: solid brand panel, always below photo -->
          <div class="doctor-card__info">
            <h3 class="doctor-card__name" data-i18n={`doctor.${doc.id}.name`}>{doc.nameRu}</h3>
            <p class="doctor-card__spec" data-i18n={`doctor.${doc.id}.spec`}>{doc.specRu}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
/* ── Section background ── */
.doctors {
  background: var(--c-surface);
}

/* ── Grid ── */
.doctors__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-4);
}

@media (min-width: 640px) {
  .doctors__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
}

@media (min-width: 1024px) {
  .doctors__grid {
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-6);
  }
}

/* ── Card — rounded corners, clean white/grey split ── */
.doctor-card {
  display: flex !important;
  flex-direction: column !important;
  border-radius: var(--r-md) !important;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  background: #ffffff;
  border-bottom: none;
  transition: box-shadow var(--t-base), transform var(--t-base);
  position: relative !important;
  aspect-ratio: unset !important;
}



/* ── Photo zone ── */
.doctor-card__photo-wrap {
  position: relative !important;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #ffffff;
  flex-shrink: 0;
  flex-grow: 0;
}

.doctor-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 10%;
  display: block;
  transition: transform 350ms ease;
}

.doctor-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(11, 42, 107, 0.25);
  background: #f7faff;
}

/* ── Text zone — fixed height, identical for every card ── */
.doctor-card__info {
  position: static !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;
  /* Light brand-blue panel */
  background: #f0f6ff !important;
  background-image: none !important;
  padding: 12px 14px 14px;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start;
  gap: 4px;
  height: 96px;
  flex-shrink: 0;
  flex-grow: 0;
  overflow: hidden;
}

@media (max-width: 639px) {
  .doctor-card__info {
    padding: 10px 12px 12px;
    height: 90px;
  }
}

/* ── Typography ── */
.doctor-card__name {
  font-family: var(--font-display);
  font-size: clamp(0.8rem, 1.5vw, 0.92rem);
  font-weight: 700;
  color: var(--c-ink) !important;
  line-height: 1.3;
  margin: 0;
  text-shadow: none;
  /* Clamp to 2 lines max — long names truncate with ellipsis */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.doctor-card__spec {
  font-size: clamp(0.7rem, 1vw, 0.78rem);
  color: var(--c-muted) !important;
  line-height: 1.35;
  margin: 0;
  /* Clamp to 2 lines max — long specialties truncate with ellipsis */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>