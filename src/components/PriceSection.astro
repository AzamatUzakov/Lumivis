<script>
  function initPriceAccordion() {
    const accordions = document.querySelectorAll<HTMLDetailsElement>("#price details");
    accordions.forEach((details) => {
      details.addEventListener("toggle", () => {
        if (typeof window !== "undefined" && (window as any).lenis?.resize) {
          (window as any).lenis.resize();
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPriceAccordion);
  } else {
    initPriceAccordion();
  }
</script>

