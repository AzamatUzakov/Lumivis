---
// WhyUsSection.astro — Editorial split layout for Lumivis with SSG translations
import type { Lang } from "../i18n/translations";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
---

<section class="whyus section" id="whyus">
  <div class="container">

    <div class="section-header reveal">
      <h2>{t("whyus.title")}</h2>
      <p>{t("whyus.subtitle")}</p>
    </div>

    <div class="whyus__body">

      <!-- ── Left Column (Item #1 + Fact Stat) ── -->
      <div class="whyus__featured reveal">
        <!-- Decorative Watermark "01" -->
        <span class="whyus__watermark" aria-hidden="true">01</span>

        <h3 class="whyus__feat-title">
          {t("whyus.1.title")}
        </h3>

        <div class="whyus__feat-rule" aria-hidden="true"></div>

        <p class="whyus__feat-text">
          {t("whyus.1.text")}
        </p>

        <!-- Compact Fact-Stat Block -->
        <div class="whyus__stat">
          <div class="whyus__stat-num">{t("whyus.stat.num")}</div>
          <div class="whyus__stat-label">
            {t("whyus.stat.label")}
          </div>
        </div>
      </div>

      <!-- ── Right Column (Items #2–#6) ── -->
      <div class="whyus__stack">

        <div class="whyus__item reveal">
          <h3>{t("whyus.2.title")}</h3>
          <p>{t("whyus.2.text")}</p>
        </div>

        <div class="whyus__item reveal">
          <h3>{t("whyus.3.title")}</h3>
          <p>{t("whyus.3.text")}</p>
        </div>

        <div class="whyus__item reveal">
          <h3>{t("whyus.4.title")}</h3>
          <p>{t("whyus.4.text")}</p>
        </div>

        <div class="whyus__item reveal">
          <h3>{t("whyus.5.title")}</h3>
          <p>{t("whyus.5.text")}</p>
        </div>

        <div class="whyus__item whyus__item--full reveal">
          <h3>{t("whyus.6.title")}</h3>
          <p>{t("whyus.6.text")}</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
/* ── Section Container ── */
.whyus {
  background: var(--c-white);
  border-top: 1px solid var(--c-border);
  border-bottom: 1px solid var(--c-border);
  position: relative;
  overflow: hidden;
}

/* ── Section Header ── */
.section-header {
  text-align: center;
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
  width: 100%;
}

.section-header h2 {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3.5vw, 2.5rem);
  font-weight: 700;
  color: var(--c-ink);
  margin-bottom: 0.75rem;
  word-break: break-word;
}

.section-header p {
  font-size: clamp(0.95rem, 1.8vw, 1.05rem);
  color: var(--c-muted);
  max-width: 52ch;
  margin-inline: auto;
  line-height: 1.6;
  word-break: break-word;
  padding-inline: 0.5rem;
}

/* ── Body Layout ── */
.whyus__body {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* ── Left Column / Featured Item #1 ── */
.whyus__featured {
  position: relative;
  display: flex;
  flex-direction: column;
  padding-top: clamp(3.25rem, 8vw, 4.5rem);
}

.whyus__watermark {
  position: absolute;
  top: 0;
  left: -0.02em;
  font-family: var(--font-display);
  font-size: clamp(5.5rem, 18vw, 7.5rem);
  font-weight: 900;
  line-height: 0.85;
  color: var(--c-sky-pale);
  opacity: 0.35;
  pointer-events: none;
  user-select: none;
  z-index: 0;
  letter-spacing: -0.03em;
}

.whyus__feat-title {
  position: relative;
  z-index: 1;
  order: 1;
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.25;
  margin-bottom: 1rem;
}

.whyus__feat-text {
  position: relative;
  z-index: 1;
  order: 2;
  font-size: 1rem;
  color: var(--c-text);
  line-height: 1.7;
  max-width: 38ch;
  margin-bottom: 1rem;
}

.whyus__feat-rule {
  position: relative;
  z-index: 1;
  order: 3;
  width: 70px;
  height: 3px;
  background: var(--c-teal);
  border-radius: 2px;
  margin-bottom: 1.25rem;
}

.whyus__stat {
  position: relative;
  z-index: 1;
  order: 4;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding-top: 1.25rem;
  border-top: 1px dashed var(--c-border);
  margin-top: 0.5rem;
  max-width: 38ch;
}

.whyus__stat-num {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 2.6vw, 2.25rem);
  font-weight: 600;
  color: var(--c-teal);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.whyus__stat-label {
  font-size: 0.85rem;
  color: var(--c-muted);
  line-height: 1.5;
}

/* ── Right Column / Stack (Items #2–#6) ── */
.whyus__stack {
  display: flex;
  flex-direction: column;
  width: 100%;
  margin-top: clamp(1.5rem, 4vw, 2.5rem);
}

.whyus__item {
  padding: 1.25rem 0;
  border-top: 1px solid var(--c-border);
}

.whyus__item:last-child {
  border-bottom: 1px solid var(--c-border);
}

.whyus__item h3 {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.35;
  margin-bottom: 0.35rem;
}

.whyus__item p {
  font-size: 0.85rem;
  color: var(--c-muted);
  line-height: 1.55;
}

@media (min-width: 640px) {
  .whyus__featured {
    max-width: 580px;
    padding-top: clamp(3rem, 7vw, 4.5rem);
  }

  .whyus__watermark {
    font-size: clamp(7rem, 14vw, 9rem);
  }

  .whyus__feat-rule {
    order: 2;
    margin-bottom: 1rem;
  }

  .whyus__feat-text {
    order: 3;
    margin-bottom: 0;
  }

  .whyus__stat {
    order: 4;
    margin-top: 1.5rem;
  }

  .whyus__stack {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
  }

  .whyus__item {
    border-top: 1px solid var(--c-border);
    border-bottom: none;
    padding: 1.25rem 0;
  }

  .whyus__item:last-child {
    border-bottom: none;
  }

  .whyus__item--full {
    grid-column: 1 / -1;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }
}

@media (min-width: 1024px) {
  .whyus__body {
    display: grid;
    grid-template-columns: 55fr 45fr;
    column-gap: clamp(3rem, 5vw, 5rem);
    align-items: stretch;
  }

  .whyus__featured {
    max-width: none;
    height: 100%;
    padding-top: clamp(3.5rem, 8vw, 5rem);
    padding-right: clamp(1.5rem, 3vw, 3rem);
    padding-bottom: 0.5rem;
    box-sizing: border-box;
  }

  .whyus__watermark {
    font-size: clamp(8rem, 10vw, 10rem);
    opacity: 0.35;
  }

  .whyus__feat-title {
    order: 1;
  }

  .whyus__feat-rule {
    order: 2;
    margin-bottom: 1.25rem;
  }

  .whyus__feat-text {
    order: 3;
  }

  .whyus__stat {
    order: 4;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .whyus__stack {
    display: flex;
    flex-direction: column;
    column-gap: 0;
    margin-top: 0;
    padding-top: 0.5rem;
  }

  .whyus__item {
    border-top: 1px solid var(--c-border);
    border-bottom: none;
    padding: 1.2rem 0;
  }

  .whyus__item:last-child {
    border-bottom: 1px solid var(--c-border);
  }

  .whyus__item--full {
    grid-column: auto;
    border-bottom: 1px solid var(--c-border);
  }
}
</style>
