---
// WhyUsSection — Variant B: editorial split
// Left: featured "01" — unique RN-screening claim (large type + watermark)
// Right: 5 remaining points — typographic stack, dividers only, no numbering
// No icons · No cards · No shadows · No uniform grid
---

<section class="whyus section" id="whyus">
  <div class="container">

    <div class="section-header">
      <h2 data-i18n="whyus.title">Почему выбирают Lumivis</h2>
      <p data-i18n="whyus.subtitle">Мы не просто лечим зрение — мы берём на себя ответственность за его будущее</p>
    </div>

    <div class="whyus__body">

      <!-- ── Left: Featured anchor — unique differentiator ── -->
      <div class="whyus__featured">
        <!-- "01" is decorative only — not part of a numbering system -->
        <span class="whyus__watermark" aria-hidden="true">01</span>

        <h3 class="whyus__feat-title" data-i18n="whyus.1.title">
          Единственные в Самарканде
        </h3>

        <div class="whyus__feat-rule" aria-hidden="true"></div>

        <p class="whyus__feat-text" data-i18n="whyus.1.text">
          Только в нашей клинике проводят скрининг и лечение ретинопатии недоношенных — по всему городу
        </p>
      </div>

      <!-- ── Right: Typographic stack — no icons, no numbers, dividers only ── -->
      <div class="whyus__stack">

        <div class="whyus__item">
          <h3 data-i18n="whyus.2.title">Экспертное оборудование</h3>
          <p data-i18n="whyus.2.text">8 профессиональных аппаратов ведущих производителей для точной диагностики и аппаратного лечения</p>
        </div>

        <div class="whyus__item">
          <h3 data-i18n="whyus.3.title">Детский приём без стресса</h3>
          <p data-i18n="whyus.3.text">Особый подход к маленьким пациентам: безболезненно, с заботой, в комфортной и спокойной обстановке</p>
        </div>

        <div class="whyus__item">
          <h3 data-i18n="whyus.4.title">Квалифицированные специалисты</h3>
          <p data-i18n="whyus.4.text">Врачи с подтверждёнными квалификациями, регулярно проходящие курсы повышения квалификации</p>
        </div>

        <div class="whyus__item">
          <h3 data-i18n="whyus.5.title">Полный цикл лечения</h3>
          <p data-i18n="whyus.5.text">От первой консультации до завершения курса — под наблюдением одного специалиста, без лишних перенаправлений</p>
        </div>

        <div class="whyus__item">
          <h3 data-i18n="whyus.6.title">Контроль результата</h3>
          <p data-i18n="whyus.6.text">Мы контролируем динамику на каждом этапе и несём ответственность за исход каждого курса лечения</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
/* ── Section: white bg, thin borders delineate without colour ── */
.whyus {
  background: var(--c-white);
  border-top: 1px solid var(--c-border);
  border-bottom: 1px solid var(--c-border);
}

/* ── Body grid: single column → split on desktop ── */
.whyus__body {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(2rem, 5vw, 3rem);
  align-items: start;
}

/* ─────────────────────────────────────────
   Featured block (left zone)
   "01" is a watermark — decorative, aria-hidden
───────────────────────────────────────── */
.whyus__featured {
  position: relative;
  overflow: hidden;
  /* top padding creates visual room beneath the watermark number */
  padding-top: clamp(3.5rem, 10vw, 5rem);
  padding-bottom: var(--s-4);
}

.whyus__watermark {
  position: absolute;
  top: -0.18em;
  left: -0.04em;
  font-family: var(--font-display);
  font-size: clamp(6rem, 22vw, 10rem);
  font-weight: 900;
  line-height: 1;
  color: var(--c-sky-pale);
  opacity: 0.55;
  pointer-events: none;
  user-select: none;
  z-index: 0;
  letter-spacing: -0.03em;
}

.whyus__feat-title {
  position: relative;
  z-index: 1;
  font-size: clamp(1.5rem, 4vw, 2.1rem);
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.2;
  margin-bottom: var(--s-5);
}

/* Teal accent line — only visual marker of hierarchy, not icon/number */
.whyus__feat-rule {
  position: relative;
  z-index: 1;
  width: 36px;
  height: 2px;
  background: var(--c-teal);
  margin-bottom: var(--s-5);
  border-radius: 1px;
}

.whyus__feat-text {
  position: relative;
  z-index: 1;
  font-size: 1rem;
  color: var(--c-text);
  line-height: 1.72;
  max-width: 40ch;
}

/* ─────────────────────────────────────────
   Typographic stack (right zone)
   Dividers only — no icons, no numbers
───────────────────────────────────────── */
.whyus__stack {
  display: flex;
  flex-direction: column;
}

.whyus__item {
  padding: var(--s-5) 0;
  border-top: 1px solid var(--c-border);
}

.whyus__item:last-child {
  border-bottom: 1px solid var(--c-border);
}

.whyus__item h3 {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.3;
  margin-bottom: var(--s-2);
}

.whyus__item p {
  font-size: 0.875rem;
  color: var(--c-muted);
  line-height: 1.6;
}

/* ── Tablet (640–899px): featured full-width → stack 2-col grid ── */
@media (min-width: 640px) and (max-width: 899px) {
  .whyus__stack {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--s-8);
  }

  /* In 2-col grid, only top border — bottom applied at container level */
  .whyus__item {
    border-top: 1px solid var(--c-border);
    border-bottom: none;
    padding: var(--s-4) 0;
  }

  .whyus__item:last-child {
    border-bottom: none;
  }

  /* Visual bottom rule under the whole stack on tablet */
  .whyus__stack {
    border-bottom: 1px solid var(--c-border);
    padding-bottom: var(--s-2);
  }
}

/* ── Desktop (≥900px): 55/45 editorial split ── */
@media (min-width: 900px) {
  .whyus__body {
    grid-template-columns: 55fr 45fr;
    gap: clamp(3rem, 6vw, 5.5rem);
  }

  .whyus__featured {
    padding-top: clamp(4.5rem, 9vw, 6rem);
    padding-bottom: var(--s-8);
    /* Subtle column separator */
    border-right: 1px solid var(--c-border);
    padding-right: clamp(2rem, 4vw, 4rem);
  }

  .whyus__watermark {
    font-size: clamp(8rem, 12vw, 11rem);
  }

  .whyus__feat-text {
    max-width: none;
  }

  /* Stack items fill the right column proportionally */
  .whyus__stack {
    padding-top: var(--s-2);
  }

  .whyus__item {
    padding: var(--s-4) 0;
  }
}

/* ── Focus states for accessibility ── */
.whyus__item h3:focus-visible {
  outline: 2px solid var(--c-sky);
  outline-offset: 2px;
  border-radius: 2px;
}
</style>
