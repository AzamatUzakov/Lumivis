---
const equipment = [
  { file: "/Huvitz.png", nameRu: "Щелевая лампа Huvitz", descRu: "Биомикроскопия переднего отрезка глаза" },
  { file: "/Labomed.png", nameRu: "Щелевая лампа Labomed", descRu: "Диагностический микроскоп высокого разрешения" },
  { file: "/biomikroskop.png", nameRu: "Офтальмологический биомикроскоп", descRu: "Детальный осмотр структур глаза" },
  { file: "/sinoptofon.png", nameRu: "Синоптофор", descRu: "Аппаратное лечение косоглазия, тренировка бинокулярного зрения" },
  { file: "/rucheek.png", nameRu: "Аппарат «Ручеёк»", descRu: "Лечение и профилактика косоглазия и амблиопии" },
  { file: "/akkomodometr.png", nameRu: "Аккомодометр", descRu: "Диагностика аккомодации глаза" },
  { file: "/amo-atos.png", nameRu: "Аппарат АМО-АТОС", descRu: "Магнитотерапия и аппаратное лечение" },
  { file: "/Gezatone.png", nameRu: "Аппарат Gezatone", descRu: "Физиотерапевтическое воздействие" },
];
---

<section class="equipment section" id="equipment">
  <div class="container">
    <div class="section-header reveal">
      <h2 data-i18n="equipment.title">Оснащение экспертного уровня</h2>
      <p data-i18n="equipment.subtitle">Профессиональные аппараты для точной диагностики и эффективного лечения</p>
    </div>

    <div class="equip-wall">
      {equipment.map((item, i) => (
        <div class="equip-cell reveal">
          <div class="equip-cell__thumb">
            <span class="equip-cell__index">{String(i + 1).padStart(2, "0")}</span>
            <img src={item.file} alt={item.nameRu} data-i18n-alt={`equip.${i + 1}.alt`} loading="lazy" decoding="async" width="240" height="240" />
          </div>
          <p class="equip-cell__name" data-i18n={`equip.${i + 1}.name`}>{item.nameRu}</p>
          <p class="equip-cell__desc" data-i18n={`equip.${i + 1}.desc`}>{item.descRu}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.equip-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--c-border);
  border: 1px solid var(--c-border);
  border-radius: var(--r-md);
  overflow: hidden;
}

.equip-cell {
  background: var(--c-white);
  padding: var(--s-3) var(--s-2);
  text-align: center;
}

.equip-cell__thumb {
  position: relative;
  aspect-ratio: 1;
  background: #f7f6f3;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: 0 auto var(--s-3);
  max-width: 220px;
}

.equip-cell__thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--s-2);
  border-radius: var(--r-sm, 8px);
}

.equip-cell__index {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--c-white);
  border: 1px solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--c-muted);
  z-index: 1;
}

.equip-cell__name {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--c-ink);
  margin: 0 0 4px;
}

.equip-cell__desc {
  font-size: 0.8rem;
  color: var(--c-muted);
  line-height: 1.45;
  margin: 0;
}

@media (min-width: 768px) {
  .equip-wall {
    grid-template-columns: repeat(4, 1fr);
  }
  .equip-cell {
    padding: var(--s-5);
  }
  .equip-cell__thumb {
    max-width: 100%;
  }
}

@media (max-width: 767px) {
  .equip-cell__desc {
    font-size: 0.72rem;
  }
}
</style>
