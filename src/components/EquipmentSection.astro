---
// EquipmentSection v2 — editorial grid, clean photo presentation
const equipment = [
  {
    file: "/Huvitz.png",
    nameRu: "Щелевая лампа Huvitz",
    descRu: "Биомикроскопия переднего отрезка глаза",
  },
  {
    file: "/Labomed.png",
    nameRu: "Щелевая лампа Labomed",
    descRu: "Диагностический микроскоп высокого разрешения",
  },
  {
    file: "/biomikroskop.png",
    nameRu: "Офтальмологический биомикроскоп",
    descRu: "Детальный осмотр структур глаза",
  },
  {
    file: "/sinoptofon.png",
    nameRu: "Синоптофор",
    descRu: "Аппаратное лечение косоглазия, тренировка бинокулярного зрения",
  },
  {
    file: "/rucheek.png",
    nameRu: "Аппарат «Ручеёк»",
    descRu: "Лечение и профилактика косоглазия и амблиопии",
  },
  {
    file: "/akkomodometr.png",
    nameRu: "Аккомодометр",
    descRu: "Диагностика аккомодации глаза",
  },
  {
    file: "/amo-atos.png",
    nameRu: "Аппарат АМО-АТОС",
    descRu: "Магнитотерапия и аппаратное лечение",
  },
  {
    file: "/Gezatone.png",
    nameRu: "Аппарат Gezatone",
    descRu: "Физиотерапевтическое воздействие",
  },
];
---

<section class="equipment section section--stone" id="equipment">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow eyebrow--amber">Технологическая база</span>
      <h2 data-i18n="equipment.title">Оснащение экспертного уровня</h2>
      <p data-i18n="equipment.subtitle">Профессиональные аппараты для точной диагностики и эффективного лечения</p>
    </div>

    <div class="equipment__grid">
      {equipment.map((item) => (
        <article class="eq-card">
          <div class="eq-card__image-container">
            <img
              src={item.file}
              alt={item.nameRu}
              class="eq-card__img"
              loading="lazy"
              decoding="async"
              width="400"
              height="320"
            />
          </div>
          <div class="eq-card__body">
            <h3 class="card-title">{item.nameRu}</h3>
            <p class="eq-card__desc">{item.descRu}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.equipment__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-4);
}

.eq-card {
  background: var(--c-white);
  border: 1px solid var(--c-border-lt);
  border-radius: var(--r-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}

.eq-card:hover {
  border-color: var(--c-border);
  box-shadow: var(--shadow-card);
}

.eq-card__image-container {
  aspect-ratio: 4 / 3;
  background: var(--c-bg);
  padding: var(--s-5);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid var(--c-border-lt);
}

.eq-card__img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: contrast(1.02);
  transition: transform var(--t-base);
}

.eq-card:hover .eq-card__img {
  transform: scale(1.03);
}

.eq-card__body {
  padding: var(--s-5);
  display: flex;
  flex-direction: column;
  gap: var(--s-1);
}

.eq-card__desc {
  font-size: 0.82rem;
  color: var(--c-muted);
  line-height: 1.5;
}

@media (min-width: 768px) {
  .equipment__grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 1100px) {
  .equipment__grid { grid-template-columns: repeat(4, 1fr); }
}
</style>
