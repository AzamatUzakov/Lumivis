---
import { Image } from "astro:assets";
import eq1 from "../assets/equipment/Huvitz.png";
import eq2 from "../assets/equipment/Labomed.png";
import eq3 from "../assets/equipment/biomikroskop.png";
import eq4 from "../assets/equipment/sinoptofon.png";
import eq5 from "../assets/equipment/rucheek.png";
import eq6 from "../assets/equipment/akkomodometr.png";
import eq7 from "../assets/equipment/amo-atos.png";
import eq8 from "../assets/equipment/Gezatone.png";

const equipment = [
  { file: eq1, nameRu: "Щелевая лампа Huvitz", descRu: "Биомикроскопия переднего отрезка глаза" },
  { file: eq2, nameRu: "Щелевая лампа Labomed", descRu: "Диагностический микроскоп высокого разрешения" },
  { file: eq3, nameRu: "Офтальмологический биомикроскоп", descRu: "Детальный осмотр структур глаза" },
  { file: eq4, nameRu: "Синоптофор", descRu: "Аппаратное лечение косоглазия, тренировка бинокулярного зрения" },
  { file: eq5, nameRu: "Аппарат «Ручеёк»", descRu: "Лечение и профилактика косоглазия и амблиопии" },
  { file: eq6, nameRu: "Аккомодометр", descRu: "Диагностика аккомодации глаза" },
  { file: eq7, nameRu: "Аппарат АМО-АТОС", descRu: "Магнитотерапия и аппаратное лечение" },
  { file: eq8, nameRu: "Аппарат Gezatone", descRu: "Физиотерапевтическое воздействие" },
];
---

<section class="equipment section" id="equipment">
  <div class="container">
    <div class="section-header reveal">
      <h2 data-i18n="equipment.title">Оснащение экспертного уровня</h2>
      <p data-i18n="equipment.subtitle">Профессиональные аппараты для точной диагностики и эффективного лечения</p>
    </div>

    <div class="equip-wall">
      {equipment.map((item, i) => (
        <div class="equip-cell reveal">
          <div class="equip-cell__thumb">
            <span class="equip-cell__index">{String(i + 1).padStart(2, "0")}</span>
            <Image
              src={item.file}
              alt={item.nameRu}
              data-i18n-alt={`equip.${i + 1}.alt`}
              loading="lazy"
              decoding="async"
              width={640}
              height={640}
              quality={92}
              format="webp"
            />
          </div>
          <h3 class="equip-cell__name" data-i18n={`equip.${i + 1}.name`}>{item.nameRu}</h3>
          <p class="equip-cell__desc" data-i18n={`equip.${i + 1}.desc`}>{item.descRu}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.equip-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: #e4eefb;
  border: 1px solid #d8e5f7;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(11, 42, 107, 0.04);
}

.equip-cell {
  background: #ffffff;
  padding: 18px 14px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.equip-cell__thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1px solid rgba(11, 42, 107, 0.08);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 14px;
  padding: 10px;
}

.equip-cell__thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  filter: drop-shadow(0 2px 8px rgba(11, 42, 107, 0.06));
}

.equip-cell__index {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #ffffff;
  border: 1px solid rgba(46, 134, 245, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72rem;
  font-weight: 700;
  color: #2e86f5;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(11, 42, 107, 0.08);
}

.equip-cell__name {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: #0b2a6b;
  margin: 0 0 6px;
  line-height: 1.3;
}

.equip-cell__desc {
  font-size: 0.82rem;
  color: #64748b;
  line-height: 1.4;
  margin: 0;
  max-width: 28ch;
}

@media (min-width: 768px) {
  .equip-wall {
    grid-template-columns: repeat(4, 1fr);
  }

  .equip-cell {
    padding: 24px 20px 26px;
  }

  .equip-cell__name {
    font-size: 1.02rem;
  }

  .equip-cell__desc {
    font-size: 0.84rem;
  }
}

@media (max-width: 639px) {
  .equip-cell {
    padding: 12px 10px 14px;
  }

  .equip-cell__thumb {
    border-radius: 10px;
    margin-bottom: 10px;
  }

  .equip-cell__index {
    top: 6px;
    left: 6px;
    width: 22px;
    height: 22px;
    font-size: 0.65rem;
  }

  .equip-cell__name {
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  .equip-cell__desc {
    font-size: 0.74rem;
    line-height: 1.35;
  }
}
</style>
