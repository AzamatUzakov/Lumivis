---
// EquipmentSection — 8 real equipment photos in unified visual style
const equipment = [
  {
    file: "/Huvitz.png",
    nameRu: "Щелевая лампа Huvitz",
    descRu: "Биомикроскопия переднего отрезка глаза",
  },
  {
    file: "/Labomed.png",
    nameRu: "Щелевая лампа Labomed",
    descRu: "Диагностический микроскоп высокого разрешения",
  },
  {
    file: "/biomikroskop.png",
    nameRu: "Офтальмологический биомикроскоп",
    descRu: "Детальный осмотр структур глаза",
  },
  {
    file: "/sinoptofon.png",
    nameRu: "Синоптофор",
    descRu: "Аппаратное лечение косоглазия, тренировка бинокулярного зрения",
  },
  {
    file: "/rucheek.png",
    nameRu: "Аппарат «Ручеёк»",
    descRu: "Лечение и профилактика косоглазия и амблиопии",
  },
  {
    file: "/akkomodometr.png",
    nameRu: "Аккомодометр",
    descRu: "Диагностика аккомодации глаза",
  },
  {
    file: "/amo-atos.png",
    nameRu: "Аппарат АМО-АТОС",
    descRu: "Магнитотерапия и аппаратное лечение",
  },
  {
    file: "/Gezatone.png",
    nameRu: "Аппарат Gezatone",
    descRu: "Физиотерапевтическое воздействие",
  },
];
---

<section class="equipment section" id="equipment">
  <div class="container">
    <div class="section-header">
      <h2 data-i18n="equipment.title">Оснащение экспертного уровня</h2>
      <p data-i18n="equipment.subtitle">Профессиональные аппараты для точной диагностики и эффективного лечения</p>
    </div>

    <div class="equipment__grid">
      {equipment.map((item) => (
        <article class="equip-card">
          <div class="equip-card__img-wrap">
            <img
              src={item.file}
              alt={item.nameRu}
              class="equip-card__img"
              loading="lazy"
              decoding="async"
              width="400"
              height="320"
            />
            <div class="equip-card__overlay-desc" aria-hidden="true">
              <p>{item.descRu}</p>
            </div>
          </div>
          <div class="equip-card__body">
            <h3 class="equip-card__name">{item.nameRu}</h3>
            <p class="equip-card__desc">{item.descRu}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.equipment__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-4);
}

.equip-card {
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--c-white);
  box-shadow: var(--shadow-card);
  transition: transform var(--t-base), box-shadow var(--t-base);
}

.equip-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-card-hover);
}

.equip-card__img-wrap {
  position: relative;
  overflow: hidden;
  background: #f5f8ff;
  aspect-ratio: 4 / 3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.equip-card__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--s-4);
  filter: brightness(1.02) contrast(1.04) saturate(0.85);
  transition: transform var(--t-slow), filter var(--t-base);
}

.equip-card:hover .equip-card__img {
  transform: scale(1.05);
  filter: brightness(1.05) contrast(1.06) saturate(0.9);
}

/* Hover overlay for description */
.equip-card__overlay-desc {
  position: absolute;
  inset: 0;
  background: rgba(11, 42, 107, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--s-5);
  opacity: 0;
  transition: opacity var(--t-base);
  backdrop-filter: blur(2px);
}

.equip-card__overlay-desc p {
  color: var(--c-white);
  text-align: center;
  font-size: 0.9rem;
  line-height: 1.6;
  font-weight: 500;
}

.equip-card:hover .equip-card__overlay-desc {
  opacity: 1;
}

/* Bottom strip */
.equip-card__body {
  padding: var(--s-4) var(--s-4);
  border-top: 2px solid var(--c-surface);
  display: flex;
  flex-direction: column;
  gap: var(--s-1);
}

.equip-card__name {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--c-ink);
  line-height: 1.3;
}

.equip-card__desc {
  font-size: 0.78rem;
  color: var(--c-muted);
  line-height: 1.5;
}

/* Left-border accent every 4th card */
.equip-card:nth-child(4n+1) { border-left: 3px solid var(--c-sky); }
.equip-card:nth-child(4n+2) { border-left: 3px solid var(--c-teal); }
.equip-card:nth-child(4n+3) { border-left: 3px solid var(--c-sky-light); }
.equip-card:nth-child(4n)   { border-left: 3px solid var(--c-teal-light); }

@media (min-width: 768px) {
  .equipment__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1100px) {
  .equipment__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
</style>
