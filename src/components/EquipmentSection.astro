---
import { Image } from "astro:assets";
import eq1 from "../assets/equipment/Huvitz.png";
import eq2 from "../assets/equipment/Labomed.png";
import eq3 from "../assets/equipment/biomikroskop.png";
import eq4 from "../assets/equipment/sinoptofon.png";
import eq5 from "../assets/equipment/rucheek.png";
import eq6 from "../assets/equipment/akkomodometr.png";
import eq7 from "../assets/equipment/amo-atos.png";
import eq8 from "../assets/equipment/Gezatone.png";
import eq9 from "../assets/equipment/mocular.png";
import eq10 from "../assets/equipment/huvitz-tono.jpg";
import { useTranslations, type SupportedLang } from "../i18n/utils";

interface Props {
  lang?: SupportedLang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);

const equipment = [
  { id: 1, file: eq1 },
  { id: 10, file: eq10 },
  { id: 2, file: eq2 },
  { id: 3, file: eq3 },
  { id: 4, file: eq4 },
  { id: 5, file: eq5 },
  { id: 6, file: eq6 },
  { id: 7, file: eq7 },
  { id: 8, file: eq8 },
  { id: 9, file: eq9 },
];
---

<section class="equipment section" id="equipment">
  <div class="container">
    <div class="section-header reveal">
      <h2 data-i18n="equipment.title">{t("equipment.title")}</h2>
      <p data-i18n="equipment.subtitle">{t("equipment.subtitle")}</p>
    </div>

    <div class="equip-wall">
      {equipment.map((item, i) => {
        const nameKey = `equip.${item.id}.name`;
        const descKey = `equip.${item.id}.desc`;
        const altKey = `equip.${item.id}.alt`;
        const eqName = t(nameKey);
        const eqDesc = t(descKey);
        const eqAlt = t(altKey);

        return (
          <div class="equip-cell reveal">
            <div class="equip-cell__thumb">
              <span class="equip-cell__index">{String(i + 1).padStart(2, "0")}</span>
              <Image
                src={item.file}
                alt={eqAlt}
                data-i18n-alt={altKey}
                loading="lazy"
                decoding="async"
                width={640}
                height={640}
                quality={92}
                format="webp"
              />
            </div>
            <h3 class="equip-cell__name" data-i18n={nameKey}>{eqName}</h3>
            <p class="equip-cell__desc" data-i18n={descKey}>{eqDesc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
.equip-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: #e4eefb;
  border: 1px solid #d8e5f7;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(11, 42, 107, 0.04);
}

.equip-cell {
  background: #ffffff;
  padding: 18px 14px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.equip-cell__thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1px solid rgba(11, 42, 107, 0.08);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 14px;
  padding: 10px;
}

.equip-cell__thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  filter: drop-shadow(0 2px 8px rgba(11, 42, 107, 0.06));
}

.equip-cell__index {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #ffffff;
  border: 1px solid rgba(46, 134, 245, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72rem;
  font-weight: 700;
  color: #2e86f5;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(11, 42, 107, 0.08);
}

.equip-cell__name {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: #0b2a6b;
  margin: 0 0 6px;
  line-height: 1.3;
}

.equip-cell__desc {
  font-size: 0.82rem;
  color: #64748b;
  line-height: 1.4;
  margin: 0;
  max-width: 28ch;
}

@media (min-width: 960px) {
  .equip-wall {
    grid-template-columns: repeat(5, 1fr);
  }

  .equip-cell {
    padding: 20px 14px 22px;
  }

  .equip-cell__name {
    font-size: 0.95rem;
  }

  .equip-cell__desc {
    font-size: 0.8rem;
  }
}

@media (max-width: 639px) {
  .equip-wall {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-padding-inline: var(--pad-x, 1rem);
    margin-inline: calc(var(--pad-x, 1rem) * -1);
    padding-inline: var(--pad-x, 1rem);
    padding-block: 4px;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    gap: 12px;
  }

  .equip-wall::-webkit-scrollbar {
    display: none;
  }

  .equip-cell {
    flex: 0 0 78%;
    scroll-snap-align: start;
    border-radius: 16px;
    border: 1px solid #d8e5f7;
    box-shadow: 0 4px 16px rgba(11, 42, 107, 0.06);
    padding: 16px 14px 18px;
  }

  .equip-cell__thumb {
    border-radius: 12px;
    margin-bottom: 10px;
  }

  .equip-cell__index {
    top: 8px;
    left: 8px;
    width: 24px;
    height: 24px;
    font-size: 0.68rem;
  }

  .equip-cell__name {
    font-size: 0.9rem;
    margin-bottom: 4px;
  }

  .equip-cell__desc {
    font-size: 0.78rem;
    line-height: 1.35;
  }
}
</style>
