# ─── Lumivis — Environment Variables ────────────────────────────────────────
# Copy this file to .env (which is git-ignored) and fill in real values.
#
# FORM INTEGRATION: Telegram Bot
# ─────────────────────────────────────────────────────────────────────────────
# Step 1: Create a bot via @BotFather on Telegram → get your token
# Step 2: Find your Chat ID by messaging @userinfobot
#         (or use the channel/group ID where you want to receive notifications)
#
# Both vars must be set for the booking form to send messages to Telegram.
# If either is missing, the form still works visually but data goes nowhere
# (a warning is printed to the browser console).
# ─────────────────────────────────────────────────────────────────────────────

# [ЗАПОЛНИТЬ: токен бота, выданный @BotFather, формат: 1234567890:AAxxxxxxx]
PUBLIC_TG_BOT_TOKEN=

# [ЗАПОЛНИТЬ: ID чата/канала/группы куда приходят заявки, формат: -100xxxxxxxxxx или числовой ID]
PUBLIC_TG_CHAT_ID=
